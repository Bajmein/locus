---
interface Item {
  title: string;
  text: string;
}

interface Props {
  items: Item[];
}

const { items } = Astro.props;
---

<dl class="caps">
  {
    items.map((item) => (
      <div class="cap">
        <dt>{item.title}</dt>
        <dd>{item.text}</dd>
      </div>
    ))
  }
</dl>

<style>
  .caps {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: 2.5rem;
    margin: 1.5rem 0 2rem;
    border-top: 1px solid var(--border);
  }

  .cap {
    padding-block: 1.25rem;
    border-bottom: 1px solid var(--border);
  }

  dt {
    font-weight: 600;
    margin-bottom: 0.35rem;
  }

  dd {
    margin: 0;
    color: var(--muted);
    font-size: 0.9688rem;
  }

  @media (max-width: 640px) {
    .caps {
      grid-template-columns: 1fr;
    }
  }
</style>
