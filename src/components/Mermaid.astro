---
interface Props {
  code: string;
  label: string;
}

const { code, label } = Astro.props;
---

<figure class="diagram" role="img" aria-label={label}>
  <pre class="mermaid">{code}</pre>
</figure>

<script>
  async function renderDiagrams() {
    const nodes = document.querySelectorAll<HTMLElement>('pre.mermaid');
    if (nodes.length === 0) return;
    const { default: mermaid } = await import('mermaid');
    mermaid.initialize({
      startOnLoad: false,
      securityLevel: 'strict',
      theme: 'base',
      fontFamily: "'Geist Variable', ui-sans-serif, system-ui, sans-serif",
      themeVariables: {
        darkMode: true,
        background: '#12151a',
        mainBkg: '#1f242c',
        primaryColor: '#1f242c',
        primaryTextColor: '#e6e8eb',
        primaryBorderColor: '#8b939e',
        secondaryColor: '#12151a',
        tertiaryColor: '#12151a',
        textColor: '#e6e8eb',
        lineColor: '#8b939e',
        nodeBorder: '#8b939e',
        clusterBkg: '#12151a',
        clusterBorder: '#1f242c',
        titleColor: '#e6e8eb',
        edgeLabelBackground: '#12151a',
        fontSize: '15px',
      },
    });
    await mermaid.run({ nodes });
  }

  renderDiagrams();
</script>

<style>
  .diagram {
    margin: 2rem 0;
    padding: 1.5rem;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow-x: auto;
  }

  .mermaid {
    margin: 0;
    padding: 0;
    background: none;
    border: 0;
    text-align: center;
    color: var(--muted);
  }

  /* Mermaid usa la clase .label en sus nodos: anular la etiqueta mono del sitio */
  .mermaid :global(.label) {
    font-family: var(--font-sans);
    font-size: inherit;
    text-transform: none;
    letter-spacing: normal;
    color: inherit;
  }

  .mermaid :global(svg) {
    max-width: 100%;
    height: auto;
  }
</style>
