---
// Nodo de diagrama: caja con nombre y, opcionalmente, una línea secundaria en mono
interface Props {
  x: number;
  y: number;
  w: number;
  h?: number;
  name: string;
  sub?: string;
  focal?: boolean;
  rx?: number;
}

const { x, y, w, h = 56, name, sub, focal = false, rx = 6 } = Astro.props;
const cx = x + w / 2;
---

<g>
  <rect class:list={['d-node', { 'is-focal': focal }]} x={x} y={y} width={w} height={h} rx={rx}></rect>
  <text class="d-name" x={cx} y={sub ? y + 24 : y + h / 2 + 5}>{name}</text>
  {sub && <text class="d-sub" x={cx} y={y + 43}>{sub}</text>}
</g>
