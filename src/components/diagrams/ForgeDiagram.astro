---
import Diagram from '../Diagram.astro';
import Node from './Node.astro';

const W = 112;
const H = 44;

// `via` es lo que dispara el paso al estado siguiente
const states = [
  { name: 'draft', via: '/approve' },
  { name: 'proposed', via: 'confirmación' },
  { name: 'approved', via: '/apply' },
  { name: 'implemented', via: '/verify + /archive' },
  { name: 'archived', via: null },
];

// Ancha: escalera, cada estado baja un peldaño a la derecha
const stairs = states.map((s, i) => ({ ...s, x: 8 + i * 124, y: 56 + i * 60 }));
const stairsPath = stairs
  .map((s, i) => (i === 0 ? `M${s.x + W / 2} 20 V${s.y + H / 2}` : `H${s.x + W / 2} V${s.y + H / 2}`))
  .join(' ');

// Angosta: lista vertical con el disparador junto a cada flecha
const list = states.map((s, i) => ({ ...s, x: 8, y: 48 + i * 80 }));
const LX = 8 + W / 2;
---

<Diagram
  id="forge"
  title="Ciclo de vida de un cambio en Forge"
  desc="Un cambio nace con /propose en estado draft, pasa a proposed con /approve, a approved con la confirmación, a implemented con /apply y termina en archived con /verify y /archive."
  wide={{ width: 640, height: 396 }}
  narrow={{ width: 224, height: 464 }}
>
  <Fragment slot="wide">
    <line class="d-line" x1="64" y1="20" x2="64" y2="56"></line>
    <text class="d-cmd" x="76" y="42">/propose</text>
    {
      stairs
        .filter((s) => s.via)
        .map((s) => (
          <>
            <path
              class="d-line"
              d={`M${s.x + W} ${s.y + 22} H${s.x + 172} Q${s.x + 180} ${s.y + 22} ${s.x + 180} ${s.y + 30} V${s.y + 60}`}
            />
            <text class="d-cmd" x={s.x + W + 8} y={s.y + 12}>
              {s.via}
            </text>
          </>
        ))
    }
    <line class="d-line" x1="560" y1="340" x2="560" y2="372"></line>

    <circle class="d-token" r="4" aria-hidden="true" style={`offset-path: path('${stairsPath} V372'); --d-dur: 8s`}
    ></circle>

    <circle class="d-dot" cx="64" cy="14" r="6"></circle>
    {stairs.map((s) => <Node x={s.x} y={s.y} w={W} h={H} rx={8} name={s.name} focal={!s.via} />)}
    <circle class="d-ring" cx="560" cy="380" r="8"></circle>
    <circle class="d-dot" cx="560" cy="380" r="4.5"></circle>
  </Fragment>

  <Fragment slot="narrow">
    <line class="d-line" x1={LX} y1="18" x2={LX} y2="48"></line>
    <text class="d-cmd" x={LX + 12} y="38">/propose</text>
    {
      list
        .filter((s) => s.via)
        .map((s) => (
          <>
            <line class="d-line" x1={LX} y1={s.y + H} x2={LX} y2={s.y + 80} />
            <text class="d-cmd" x={LX + 12} y={s.y + H + 22}>
              {s.via}
            </text>
          </>
        ))
    }
    <line class="d-line" x1={LX} y1="412" x2={LX} y2="440"></line>

    <circle class="d-token" r="4" aria-hidden="true" style={`offset-path: path('M${LX} 18 V440'); --d-dur: 8s`}
    ></circle>

    <circle class="d-dot" cx={LX} cy="12" r="6"></circle>
    {list.map((s) => <Node x={s.x} y={s.y} w={W} h={H} rx={8} name={s.name} focal={!s.via} />)}
    <circle class="d-ring" cx={LX} cy="448" r="8"></circle>
    <circle class="d-dot" cx={LX} cy="448" r="4.5"></circle>
  </Fragment>
</Diagram>
