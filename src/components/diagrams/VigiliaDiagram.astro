---
import Diagram from '../Diagram.astro';

const W = 144;
const H = 52;

// Rejilla de 4 columnas × 3 filas; el flujo principal entra arriba a la izquierda y sale abajo
const nodes = [
  { x: 24, y: 56, name: 'Cámara', sub: 'entrada de video' },
  { x: 204, y: 56, name: 'Decodificador', sub: 'frames' },
  { x: 384, y: 56, name: 'Bus compartido', sub: 'shared memory' },
  { x: 564, y: 56, name: 'ONNX Runtime', sub: 'GPU', focal: true },
  { x: 204, y: 144, name: 'Planificador', sub: 'scheduler' },
  { x: 564, y: 144, name: 'Evaluador', sub: 'zonas' },
  { x: 204, y: 256, name: 'Configuración', sub: 'Pydantic' },
  { x: 384, y: 256, name: 'API y mensajería', sub: 'FastAPI · MQTT' },
  { x: 564, y: 256, name: 'Motor de reglas', sub: 'reglas declarativas' },
];
---

<Diagram
  id="vigilia"
  title="Arquitectura de Vigilia"
  desc="El video de la cámara pasa por el decodificador y el bus de memoria compartida del núcleo en Rust, sigue por la inferencia con ONNX Runtime en GPU y el evaluador de zonas, y termina en el motor de reglas y la API de la orquestación en Python, cuya configuración gobierna al planificador."
  width={744}
  height={380}
>
  <rect class="d-zone" x="192" y="24" width="348" height="184" rx="8"></rect>
  <text class="d-eyebrow" x="204" y="44">Rust · PyO3</text>
  <rect class="d-zone" x="552" y="24" width="168" height="184" rx="8"></rect>
  <text class="d-eyebrow" x="564" y="44">Inferencia</text>
  <rect class="d-zone" x="192" y="224" width="528" height="96" rx="8"></rect>
  <text class="d-eyebrow" x="204" y="244">Python</text>

  <line class="d-line is-accent" x1="168" y1="82" x2="204" y2="82"></line>
  <line class="d-line is-accent" x1="348" y1="82" x2="384" y2="82"></line>
  <line class="d-line is-accent" x1="528" y1="82" x2="564" y2="82"></line>
  <line class="d-line is-accent" x1="636" y1="108" x2="636" y2="144"></line>
  <line class="d-line is-accent" x1="636" y1="196" x2="636" y2="256"></line>
  <line class="d-line is-accent" x1="564" y1="282" x2="528" y2="282"></line>
  <line class="d-line" x1="276" y1="256" x2="276" y2="196"></line>
  <line class="d-line" x1="276" y1="144" x2="276" y2="108"></line>

  <circle
    class="d-token"
    r="3.5"
    aria-hidden="true"
    style="offset-path: path('M96 82 H636 V282 H456'); --d-dur: 7s"></circle>

  {
    nodes.map((n) => (
      <g>
        <rect class:list={['d-node', { 'is-focal': n.focal }]} x={n.x} y={n.y} width={W} height={H} rx="6" />
        <text class="d-name" x={n.x + W / 2} y={n.y + 23}>
          {n.name}
        </text>
        <text class="d-sub" x={n.x + W / 2} y={n.y + 39}>
          {n.sub}
        </text>
      </g>
    ))
  }

  <line class="d-rule" x1="24" y1="344" x2="720" y2="344"></line>
  <line class="d-line is-accent is-plain" x1="24" y1="362" x2="52" y2="362"></line>
  <text class="d-eyebrow" x="62" y="365">Video y eventos</text>
  <line class="d-line is-plain" x1="224" y1="362" x2="252" y2="362"></line>
  <text class="d-eyebrow" x="262" y="365">Configuración y control</text>
</Diagram>
