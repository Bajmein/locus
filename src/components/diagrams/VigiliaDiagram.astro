---
import Diagram from '../Diagram.astro';
import Node from './Node.astro';

// Ancha: 4 columnas × 3 filas; el flujo principal entra arriba a la izquierda y sale abajo
const wide = [
  { x: 10, y: 40, w: 128, name: 'Cámara', sub: 'entrada de video' },
  { x: 182, y: 40, w: 120, name: 'Decodificador', sub: 'frames' },
  { x: 326, y: 40, w: 128, name: 'Bus compartido', sub: 'shared memory' },
  { x: 490, y: 40, w: 128, name: 'ONNX Runtime', sub: 'GPU', focal: true },
  { x: 182, y: 128, w: 120, name: 'Planificador', sub: 'scheduler' },
  { x: 490, y: 128, w: 128, name: 'Evaluador', sub: 'zonas' },
  { x: 182, y: 244, w: 120, name: 'Configuración', sub: 'Pydantic' },
  { x: 326, y: 244, w: 128, name: 'API y mensajería', sub: 'FastAPI · MQTT' },
  { x: 490, y: 244, w: 128, name: 'Motor de reglas', sub: 'declarativo' },
];

// Angosta: el flujo principal baja por la izquierda; el control sube por la derecha.
// Las etiquetas de zona van entre ambas líneas verticales (x = 75 y x = 214) para no cruzarse con ellas
const narrow = [
  { x: 10, y: 4, w: 130, name: 'Cámara', sub: 'entrada de video' },
  { x: 10, y: 116, w: 130, name: 'Decodificador', sub: 'frames' },
  { x: 160, y: 116, w: 108, name: 'Planificador', sub: 'scheduler' },
  { x: 10, y: 200, w: 130, name: 'Bus compartido', sub: 'shared memory' },
  { x: 10, y: 316, w: 130, name: 'ONNX Runtime', sub: 'GPU', focal: true },
  { x: 10, y: 400, w: 130, name: 'Evaluador', sub: 'zonas' },
  { x: 10, y: 516, w: 130, name: 'Motor de reglas', sub: 'declarativo' },
  { x: 160, y: 516, w: 108, name: 'Configuración', sub: 'Pydantic' },
  { x: 10, y: 600, w: 130, name: 'API y mensajería', sub: 'FastAPI · MQTT' },
];
---

<Diagram
  id="vigilia"
  title="Arquitectura de Vigilia"
  desc="El video de la cámara pasa por el decodificador y el bus de memoria compartida del núcleo en Rust, sigue por la inferencia con ONNX Runtime en GPU y el evaluador de zonas, y termina en el motor de reglas y la API de la orquestación en Python, cuya configuración gobierna al planificador."
  wide={{ width: 640, height: 368 }}
  narrow={{ width: 280, height: 748 }}
>
  <Fragment slot="wide">
    <rect class="d-zone" x="170" y="8" width="296" height="188" rx="8"></rect>
    <text class="d-eyebrow" x="182" y="28">Rust · PyO3</text>
    <rect class="d-zone" x="478" y="8" width="152" height="188" rx="8"></rect>
    <text class="d-eyebrow" x="490" y="28">Inferencia</text>
    <rect class="d-zone" x="170" y="212" width="460" height="100" rx="8"></rect>
    <text class="d-eyebrow" x="182" y="232">Python</text>

    <line class="d-line is-accent" x1="138" y1="68" x2="182" y2="68"></line>
    <line class="d-line is-accent" x1="302" y1="68" x2="326" y2="68"></line>
    <line class="d-line is-accent" x1="454" y1="68" x2="490" y2="68"></line>
    <line class="d-line is-accent" x1="554" y1="96" x2="554" y2="128"></line>
    <line class="d-line is-accent" x1="554" y1="184" x2="554" y2="244"></line>
    <line class="d-line is-accent" x1="490" y1="272" x2="454" y2="272"></line>
    <line class="d-line" x1="242" y1="244" x2="242" y2="184"></line>
    <line class="d-line" x1="242" y1="128" x2="242" y2="96"></line>

    <circle class="d-token" r="4" aria-hidden="true" style="offset-path: path('M74 68 H554 V272 H390'); --d-dur: 7s"
    ></circle>

    {wide.map((n) => <Node {...n} />)}

    <line class="d-rule" x1="10" y1="332" x2="630" y2="332"></line>
    <line class="d-line is-accent is-plain" x1="10" y1="352" x2="38" y2="352"></line>
    <text class="d-eyebrow" x="48" y="356">Video y eventos</text>
    <line class="d-line is-plain" x1="210" y1="352" x2="238" y2="352"></line>
    <text class="d-eyebrow" x="248" y="356">Configuración y control</text>
  </Fragment>

  <Fragment slot="narrow">
    <rect class="d-zone" x="0.5" y="84" width="279" height="184" rx="8"></rect>
    <text class="d-eyebrow" x="88" y="104">Rust · PyO3</text>
    <rect class="d-zone" x="0.5" y="284" width="279" height="184" rx="8"></rect>
    <text class="d-eyebrow" x="88" y="304">Inferencia</text>
    <rect class="d-zone" x="0.5" y="484" width="279" height="184" rx="8"></rect>
    <text class="d-eyebrow" x="88" y="504">Python</text>

    <line class="d-line is-accent" x1="75" y1="60" x2="75" y2="116"></line>
    <line class="d-line is-accent" x1="75" y1="172" x2="75" y2="200"></line>
    <line class="d-line is-accent" x1="75" y1="256" x2="75" y2="316"></line>
    <line class="d-line is-accent" x1="75" y1="372" x2="75" y2="400"></line>
    <line class="d-line is-accent" x1="75" y1="456" x2="75" y2="516"></line>
    <line class="d-line is-accent" x1="75" y1="572" x2="75" y2="600"></line>
    <line class="d-line" x1="214" y1="516" x2="214" y2="172"></line>
    <line class="d-line" x1="160" y1="144" x2="140" y2="144"></line>

    <circle class="d-token" r="4" aria-hidden="true" style="offset-path: path('M75 32 V628'); --d-dur: 7s"></circle>

    {narrow.map((n) => <Node {...n} />)}

    <line class="d-rule" x1="0.5" y1="688" x2="279.5" y2="688"></line>
    <line class="d-line is-accent is-plain" x1="10" y1="708" x2="38" y2="708"></line>
    <text class="d-eyebrow" x="48" y="712">Video y eventos</text>
    <line class="d-line is-plain" x1="10" y1="732" x2="38" y2="732"></line>
    <text class="d-eyebrow" x="48" y="736">Configuración y control</text>
  </Fragment>
</Diagram>
