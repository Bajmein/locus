---
/*
 * Marco de los diagramas. Cada diagrama trae dos composiciones del mismo contenido, en SVG en línea
 * (así conserva el punto animado y los tokens de color):
 * - `wide`: hasta 640 unidades de ancho; se muestra cuando la figura mide 640 px o más.
 * - `narrow`: vertical, hasta 280 unidades; para móviles y columnas angostas.
 * Ninguna se dibuja por debajo de 1:1 (`min-width` = ancho del viewBox), así que el texto de 12 unidades
 * mide al menos 12 px reales. Si la figura es más angosta que la composición, se desplaza dentro de ella.
 */
export const WIDE_MAX = 640;
export const NARROW_MAX = 280;

interface Layout {
  width: number;
  height: number;
}

interface Props {
  /** Prefijo de los id del SVG; único por página */
  id: string;
  title: string;
  desc: string;
  wide: Layout;
  narrow: Layout;
}

const { id, title, desc, wide, narrow } = Astro.props;
if (wide.width > WIDE_MAX || narrow.width > NARROW_MAX) {
  throw new Error(`Diagrama ${id}: la composición ancha admite ${WIDE_MAX} y la angosta ${NARROW_MAX} de ancho`);
}

const layouts = [
  { key: 'wide', ...wide },
  { key: 'narrow', ...narrow },
] as const;
---

<figure class="diagram glass reveal">
  {/* Marcadores compartidos: un SVG sin tamaño, no oculto con display, para que las flechas los encuentren */}
  <svg class="defs" width="0" height="0" aria-hidden="true" focusable="false">
    <defs>
      <marker id="dg-arrow" markerWidth="8" markerHeight="6" refX="7" refY="3" orient="auto">
        <polygon class="d-head" points="0 0, 8 3, 0 6"></polygon>
      </marker>
      <marker id="dg-arrow-accent" markerWidth="8" markerHeight="6" refX="7" refY="3" orient="auto">
        <polygon class="d-head is-accent" points="0 0, 8 3, 0 6"></polygon>
      </marker>
    </defs>
  </svg>
  <div class="scroll">
    {
      layouts.map((l) => (
        <svg
          class={`layout is-${l.key}`}
          viewBox={`0 0 ${l.width} ${l.height}`}
          role="img"
          aria-labelledby={`${id}-${l.key}-title ${id}-${l.key}-desc`}
          style={`--w: ${l.width}px`}
        >
          <title id={`${id}-${l.key}-title`}>{title}</title>
          <desc id={`${id}-${l.key}-desc`}>{desc}</desc>
          {l.key === 'wide' ? <slot name="wide" /> : <slot name="narrow" />}
        </svg>
      ))
    }
  </div>
</figure>

<style>
  .diagram {
    margin: 2rem 0;
    padding: 1.25rem;
  }

  .defs {
    position: absolute;
    width: 0;
    height: 0;
    overflow: hidden;
  }

  /* Contenedor de consulta: la composición se elige por el ancho de la figura, no de la ventana */
  .scroll {
    overflow-x: auto;
    container-type: inline-size;
  }

  /* Nunca por debajo de 1:1 (texto de 12 unidades = 12 px); crece a lo sumo un 15 % */
  .layout {
    display: block;
    width: 100%;
    min-width: var(--w);
    max-width: calc(var(--w) * 1.15);
    height: auto;
    margin-inline: auto;
  }

  .layout.is-narrow {
    display: none;
  }

  /* 640 = WIDE_MAX */
  @container (width < 640px) {
    .layout.is-wide {
      display: none;
    }

    .layout.is-narrow {
      display: block;
    }
  }

  /* Las piezas llegan por <slot>, así que sus clases son globales bajo .diagram */
  .diagram :global(.d-zone) {
    fill: color-mix(in srgb, var(--text) 2%, transparent);
    stroke: color-mix(in srgb, var(--text) 10%, transparent);
    stroke-width: 1;
  }

  .diagram :global(.d-eyebrow) {
    font: 400 12px var(--font-mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    fill: var(--muted);
  }

  .diagram :global(.d-line) {
    fill: none;
    stroke: var(--muted);
    stroke-width: 1.2;
    marker-end: url('#dg-arrow');
  }

  .diagram :global(.d-line.is-accent) {
    stroke: var(--accent);
    marker-end: url('#dg-arrow-accent');
  }

  .diagram :global(.d-line.is-plain) {
    marker-end: none;
  }

  .diagram :global(.d-head) {
    fill: var(--muted);
  }

  .diagram :global(.d-head.is-accent) {
    fill: var(--accent);
  }

  /* Relleno opaco: tapa las líneas y el punto de flujo que pasan por detrás */
  .diagram :global(.d-node) {
    fill: var(--surface);
    stroke: color-mix(in srgb, var(--text) 20%, var(--surface));
    stroke-width: 1;
    transition: stroke 0.2s ease;
  }

  .diagram :global(.d-node.is-focal) {
    fill: color-mix(in srgb, var(--accent) 12%, var(--surface));
    stroke: var(--accent);
  }

  .diagram :global(g:hover > .d-node) {
    stroke: var(--accent);
  }

  .diagram :global(.d-name) {
    font: 600 14px var(--font-sans);
    fill: var(--text);
    text-anchor: middle;
  }

  .diagram :global(.d-sub) {
    font: 400 12px var(--font-mono);
    fill: var(--muted);
    text-anchor: middle;
  }

  .diagram :global(.d-cmd) {
    font: 400 12px var(--font-mono);
    fill: var(--muted);
  }

  .diagram :global(.d-rule) {
    stroke: color-mix(in srgb, var(--text) 10%, transparent);
    stroke-width: 1;
  }

  .diagram :global(.d-dot) {
    fill: var(--text);
  }

  .diagram :global(.d-ring) {
    fill: none;
    stroke: var(--text);
    stroke-width: 1.2;
  }

  /* Punto de flujo: decorativo, solo con soporte y sin preferencia de movimiento reducido */
  .diagram :global(.d-token) {
    display: none;
    fill: var(--accent);
    offset-rotate: 0deg;
  }

  @media (prefers-reduced-motion: no-preference) {
    @supports (offset-path: path('M0 0')) {
      .diagram :global(.d-token) {
        display: inline;
        animation: d-flow var(--d-dur, 6s) linear infinite;
      }
    }
  }

  @keyframes d-flow {
    0% {
      offset-distance: 0%;
      opacity: 0;
    }

    5%,
    95% {
      opacity: 1;
    }

    100% {
      offset-distance: 100%;
      opacity: 0;
    }
  }

  @media print {
    .diagram :global(.d-token) {
      display: none;
    }
  }
</style>
