---
import { nav } from '../data/site';
import { projects } from '../data/projects';

const path = Astro.url.pathname;
const enProyecto = projects.some((p) => path === `/${p.slug}/`);

function actual(href: string) {
  if (href === path) return 'page';
  if (href === '/#proyectos' && enProyecto) return 'true';
  return undefined;
}
---

<header class="site-header">
  <div class="container bar">
    <a class="brand" href="/"
      ><span aria-hidden="true">bc<span class="cursor">_</span></span><span class="sr-only"
        >Benjamín Criado, inicio</span
      ></a
    >
    <nav aria-label="Principal">
      <ul>
        {
          nav.map((item) => (
            <li>
              <a href={item.href} aria-current={actual(item.href)}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header {
    border-bottom: 1px solid var(--border);
    /* Glass al 85 %: el contenido apenas se insinúa bajo la barra al hacer scroll */
    background: color-mix(in srgb, var(--bg) 85%, transparent);
    -webkit-backdrop-filter: blur(16px) saturate(140%);
    backdrop-filter: blur(16px) saturate(140%);
    position: sticky;
    top: 0;
    z-index: 10;
    view-transition-name: site-header;
  }

  @supports not ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) {
    .site-header {
      background: var(--bg);
    }
  }

  @media (prefers-reduced-transparency: reduce) {
    .site-header {
      background: var(--bg);
      -webkit-backdrop-filter: none;
      backdrop-filter: none;
    }
  }

  /* Progreso de lectura: línea de 1 px en el acento */
  @supports (animation-timeline: scroll()) {
    .site-header::after {
      content: '';
      position: absolute;
      inset: auto 0 -1px 0;
      height: 1px;
      background: var(--accent);
      /* Oculta por defecto: en páginas sin scroll la línea de tiempo queda inactiva */
      transform: scaleX(0);
      transform-origin: left;
      animation: progress linear both;
    }

    /* Regla aparte: el minificador funde animation-timeline en el atajo animation y lo invalida */
    header.site-header::after {
      animation-timeline: scroll(root);
    }
  }

  @keyframes progress {
    to {
      transform: scaleX(1);
    }
  }

  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    height: 3.75rem;
  }

  .brand {
    font-family: var(--font-mono);
    font-weight: 600;
    font-size: 1.0625rem;
    color: var(--text);
    text-decoration: none;
  }

  .brand .cursor {
    color: var(--accent);
  }

  ul {
    display: flex;
    gap: clamp(0.85rem, 3vw, 2rem);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  li + li {
    margin: 0;
  }

  nav a {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--muted);
    text-decoration: none;
  }

  nav a:hover,
  nav a[aria-current] {
    color: var(--text);
  }

  nav a[aria-current] {
    text-decoration: underline;
    text-decoration-color: var(--accent);
    text-underline-offset: 0.45em;
  }

  @media (max-width: 400px) {
    nav a {
      font-size: 0.875rem;
    }
  }
</style>
