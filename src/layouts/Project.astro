---
import Base from './Base.astro';
import { site } from '../data/site';

interface Props {
  title: string;
  description: string;
  tagline: string;
  stack: string[];
  status: string;
  repoUrl?: string;
}

const { title, description, tagline, stack, status, repoUrl } = Astro.props;
const slug = Astro.url.pathname.replaceAll('/', '');

const schema = {
  '@type': 'SoftwareSourceCode',
  name: title,
  description,
  url: new URL(Astro.url.pathname, Astro.site).href,
  keywords: stack.join(', '),
  ...(repoUrl ? { sameAs: repoUrl } : {}),
};
---

<Base title={`${title} — Benjamín Criado`} description={description} schema={schema} tone={slug}>
  <article class="container project">
    <nav class="crumbs" aria-label="Migas">
      <a href="/#proyectos" class="label">← Proyectos</a>
    </nav>

    <header class="project-head">
      <h1 style={`view-transition-name: proyecto-${slug}`}>{title}</h1>
      <p class="tagline">{tagline}</p>
    </header>

    <div class="project-grid">
      <aside class="glass meta" aria-label="Ficha del proyecto">
        <p class="label">Estado</p>
        <p class="status">{status}</p>
        <p class="label">Stack</p>
        <ul class="stack label">
          {stack.map((item) => <li>{item}</li>)}
        </ul>
      </aside>
      <div class="body prose">
        <slot />
      </div>
    </div>

    <footer class="project-foot">
      {
        repoUrl && (
          <div>
            <p class="label">Código</p>
            <p>El código fuente es privado. El repositorio vitrina muestra la arquitectura y la documentación técnica.</p>
            <a class="btn btn-primary" href={repoUrl}>
              Ver repositorio vitrina
            </a>
          </div>
        )
      }
      <div>
        <p class="label">Contacto</p>
        <p>¿Preguntas sobre este proyecto? Escríbeme.</p>
        <a class="btn" href={`mailto:${site.email}`}>{site.email}</a>
      </div>
    </footer>
  </article>
</Base>

<style>
  .project {
    padding-block: 2.5rem 4rem;
  }

  .crumbs {
    margin-bottom: 2.5rem;
  }

  .crumbs a {
    text-decoration: none;
  }

  .crumbs a:hover {
    color: var(--accent);
  }

  .project-head {
    padding-bottom: 2.5rem;
    border-bottom: 1px solid var(--border);
    margin-bottom: 2.5rem;
  }

  .project-head h1 {
    width: fit-content;
  }

  .tagline {
    font-size: clamp(1.125rem, 2.2vw, 1.3125rem);
    color: var(--muted);
    max-width: var(--w-prose);
    margin-bottom: 0;
  }

  .project-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 17rem;
    gap: 2rem 3.5rem;
    align-items: start;
  }

  .body {
    grid-column: 1;
    grid-row: 1;
  }

  .meta {
    grid-column: 2;
    grid-row: 1;
    position: sticky;
    top: 5.5rem;
    padding: 1.25rem 1.5rem;
  }

  .meta p.label {
    margin: 0 0 0.4rem;
    color: var(--accent);
  }

  .status {
    margin: 0 0 1.25rem;
    font-size: 0.9375rem;
    color: var(--text);
  }

  .stack {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    list-style: none;
    padding: 0;
    margin: 0;
    color: var(--text);
  }

  .stack li {
    margin: 0;
  }

  .stack li::before {
    content: '/ ';
    color: var(--accent);
  }

  @media (max-width: 960px) {
    .project-grid {
      grid-template-columns: minmax(0, 1fr);
    }

    .body,
    .meta {
      grid-column: 1;
      grid-row: auto;
    }

    .meta {
      position: static;
    }

    .stack {
      flex-direction: row;
      flex-wrap: wrap;
      gap: 0.4rem 1.25rem;
    }
  }

  .body :global(h2) {
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 1px solid var(--border);
  }

  .body :global(h2:first-child) {
    margin-top: 0;
    padding-top: 0;
    border-top: 0;
  }

  .project-foot {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
    gap: 2rem 3rem;
    margin-top: 4rem;
    padding-top: 2.5rem;
    border-top: 1px solid var(--border);
  }

  .project-foot p:not(.label) {
    color: var(--muted);
    font-size: 0.9375rem;
  }

  .project-foot .label {
    margin-bottom: 0.5rem;
  }
</style>
