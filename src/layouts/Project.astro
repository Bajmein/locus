---
import Base from './Base.astro';
import { site } from '../data/site';
import ProjectIcon from '../components/ProjectIcon.astro';
import { projects } from '../data/projects';

interface Props {
  title: string;
  description: string;
  tagline: string;
  stack: string[];
  status: string;
  repoUrl?: string;
}

const { title, description, tagline, stack, status, repoUrl } = Astro.props;
const slug = Astro.url.pathname.replaceAll('/', '');
const index = projects.findIndex((p) => p.slug === slug);
const next = projects[(index + 1) % projects.length];
const period = projects[index]?.period;
const group = projects[index]?.group ?? 'agentes';
// Rótulo sobre el título (como en la tarjeta) y clase que detecta la caja (en minúsculas, como «persona 0,99»)
const groupLabel = { agentes: 'Agentes de IA', vision: 'Visión por computador' }[group];
const detected = { agentes: 'agentes de IA', vision: 'visión por computador' }[group];

const schema = {
  '@type': 'SoftwareSourceCode',
  name: title,
  description,
  url: new URL(Astro.url.pathname, Astro.site).href,
  keywords: stack.join(', '),
  ...(repoUrl ? { sameAs: repoUrl } : {}),
};
---

<Base title={`${title} — Benjamín Criado`} description={description} schema={schema} tone={slug}>
  <article class="container project">
    <nav class="crumbs" aria-label="Migas">
      <a href="/#proyectos" class="label">← Proyectos</a>
    </nav>

    <header class="project-head">
      <p class="label group">{groupLabel}</p>
      <div class="head-row">
        <ProjectIcon slug={slug} size="lg" />
        <div class="target">
          <h1 style={`view-transition-name: proyecto-${slug}`}>{title}</h1>
          <span class="bbox" aria-hidden="true">
            <i></i><i></i><i></i><i></i>
            <b class="mono">{detected}</b>
          </span>
        </div>
      </div>
      <p class="tagline">{tagline}</p>
    </header>

    <div class="project-grid">
      <aside class="glass meta" aria-label="Ficha del proyecto">
        <p class="label">Estado</p>
        <p class="status">{status}</p>
        <p class="label">Período</p>
        <p class="status">{period}</p>
      </aside>
      <div class="body prose">
        <slot />
      </div>
    </div>

    <footer class="project-foot">
      {
        repoUrl && (
          <div>
            <p class="label">Código</p>
            <p>El código fuente es privado. El repositorio vitrina muestra la arquitectura y la documentación técnica.</p>
            <a class="btn btn-primary" href={repoUrl}>
              Ver repositorio vitrina
            </a>
          </div>
        )
      }
      <div>
        <p class="label">Contacto</p>
        <p>¿Necesitas algo parecido en tu equipo o tu empresa? Escríbeme.</p>
        <a class="btn" href={`mailto:${site.email}`}>{site.email}</a>
      </div>
    </footer>

    <nav class="next" aria-label="Proyecto siguiente">
      <a
        class="project-card next-link glass spot"
        href={`/${next.slug}/`}
        style={`--accent: var(--tone-${next.slug})`}
      >
        <span class="label">Siguiente proyecto</span>
        <span class="next-main">
          <ProjectIcon slug={next.slug} />
          <span class="next-text">
            <span class="next-title">{next.title}</span>
            <span class="next-desc">{next.card.text}</span>
          </span>
          <span class="arrow" aria-hidden="true">→</span>
        </span>
      </a>
    </nav>
  </article>
</Base>

<style>
  .project {
    padding-block: 2.5rem 4rem;
  }

  .crumbs {
    margin-bottom: 2.5rem;
  }

  .crumbs a {
    text-decoration: none;
  }

  .crumbs a:hover {
    color: var(--accent);
  }

  .project-head {
    padding-bottom: 2.5rem;
    border-bottom: 1px solid var(--border);
    margin-bottom: 2.5rem;
  }

  /* Deja sitio a la etiqueta de la caja de detección, que va sobre el título */
  .group {
    margin-bottom: 3.25rem;
    color: var(--accent);
  }

  /* El hueco cubre el margen de la caja (1,25rem) a la izquierda del título */
  .head-row {
    display: flex;
    align-items: center;
    gap: 2.25rem;
    margin-bottom: 2rem;
  }

  /* Margen derecho para la caja, que sobresale del título */
  .head-row .target {
    min-width: 0;
    margin-right: 1.25rem;
  }

  @media (max-width: 760px) {
    .head-row {
      gap: 1.5rem;
    }

    .head-row .target {
      margin-right: 0.75rem;
    }
  }

  .project-head h1 {
    width: fit-content;
    margin: 0;
  }

  /* En la página del proyecto la caja se fija antes que en la portada, que espera al nombre */
  .project-head .bbox {
    animation-delay: 0.3s;
  }

  .project-head .bbox b {
    animation-delay: 0.75s;
  }

  .tagline {
    font-size: clamp(1.125rem, 2.2vw, 1.3125rem);
    color: var(--muted);
    max-width: var(--w-prose);
    margin-bottom: 0;
  }

  .project-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 17rem;
    gap: 2rem 3.5rem;
    align-items: start;
  }

  .body {
    grid-column: 1;
    grid-row: 1;
  }

  .meta {
    grid-column: 2;
    grid-row: 1;
    position: sticky;
    top: 5.5rem;
    padding: 1.25rem 1.5rem;
  }

  .meta p.label {
    margin: 0 0 0.4rem;
    color: var(--accent);
  }

  .status {
    margin: 0 0 1.25rem;
    font-size: 0.9375rem;
    color: var(--text);
  }

  @media (max-width: 960px) {
    .project-grid {
      grid-template-columns: minmax(0, 1fr);
    }

    .body,
    .meta {
      grid-column: 1;
      grid-row: auto;
    }

    .meta {
      position: static;
    }
  }

  .body :global(h2) {
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 1px solid var(--border);
    font-family: var(--font-display);
    font-stretch: 112%;
    font-weight: 700;
  }

  /* La misma barra del acento (aquí, el tono del proyecto) que los títulos de sección */
  .body :global(h2)::after {
    content: '';
    display: block;
    width: 3rem;
    height: 2px;
    margin-top: 0.9rem;
    border-radius: 1px;
    background: var(--accent);
    transform-origin: left;
  }

  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: view()) {
      .body :global(h2)::after {
        animation: grow linear both;
      }

      /* Regla aparte: el minificador funde animation-timeline en el atajo animation y lo invalida */
      div.body :global(h2)::after {
        animation-timeline: view();
        animation-range: entry 0% entry 60%;
      }
    }
  }

  .body :global(h2:first-child) {
    margin-top: 0;
    padding-top: 0;
    border-top: 0;
  }

  .project-foot {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
    gap: 2rem 3rem;
    margin-top: 4rem;
    padding-top: 2.5rem;
    border-top: 1px solid var(--border);
    content-visibility: auto;
    contain-intrinsic-size: auto 14rem;
  }

  .project-foot p:not(.label) {
    color: var(--muted);
    font-size: 0.9375rem;
  }

  .project-foot .label {
    margin-bottom: 0.5rem;
  }

  .next {
    margin-top: 3rem;
    content-visibility: auto;
    contain-intrinsic-size: auto 9rem;
  }

  .next-link {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding: 1.25rem 1.5rem;
    text-decoration: none;
    color: var(--text);
    transition: border-color 0.25s ease;
  }

  .next-link:hover,
  .next-link:focus-visible {
    border-color: var(--accent);
  }

  .next-link .label {
    color: var(--accent);
  }

  .next-main {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
  }

  .next-text {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    min-width: 0;
    flex: 1;
  }

  .next-title {
    font-family: var(--font-display);
    font-size: 1.375rem;
    font-weight: 700;
    font-stretch: 112%;
  }

  .next-desc {
    color: var(--muted);
    font-size: 0.9375rem;
  }

  .next-link .arrow {
    color: var(--muted);
    transition:
      color 0.2s ease,
      transform 0.2s ease;
  }

  .next-link:hover .arrow,
  .next-link:focus-visible .arrow {
    color: var(--accent);
    transform: translateX(0.25rem);
  }

  @media (prefers-reduced-motion: reduce) {
    .next-link:hover .arrow,
    .next-link:focus-visible .arrow {
      transform: none;
    }
  }
</style>
