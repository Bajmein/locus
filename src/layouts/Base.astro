---
import '@fontsource-variable/archivo/wdth.css';
import '@fontsource-variable/geist';
import '@fontsource-variable/geist-mono';
import '../styles/global.css';
import archivoLatin from '@fontsource-variable/archivo/files/archivo-latin-wdth-normal.woff2?url';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site';

interface Props {
  title: string;
  description?: string;
  /** Solo la 404: no indexar, sin canonical ni og:url */
  noindex?: boolean;
  /** Nodo JSON-LD de la página; se añade al @graph con la persona como autora */
  schema?: Record<string, unknown>;
  /** Slug del proyecto cuyo tono (--tone-<slug>) reemplaza a --accent en toda la página */
  tone?: string;
}

const { title, description = site.description, noindex = false, schema, tone } = Astro.props;
const siteUrl = Astro.site ?? new URL('https://benjamincriado.dev');
const canonical = new URL(Astro.url.pathname, siteUrl).href;
const ogImage = new URL('/og.png', siteUrl).href;

const personId = `${siteUrl.href}#persona`;
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Person',
      '@id': personId,
      name: site.alias,
      alternateName: site.alternateNames,
      description: site.description,
      jobTitle: site.jobTitle,
      url: siteUrl.href,
      email: `mailto:${site.email}`,
      sameAs: [site.github, site.linkedin],
      knowsAbout: [
        'Python',
        'Agentes de IA',
        'Model Context Protocol (MCP)',
        'Desarrollo de software',
        'Automatización de procesos',
        'Computación en la nube',
        'Integración de sistemas',
        'Inteligencia artificial aplicada',
      ],
      address: {
        '@type': 'PostalAddress',
        addressLocality: 'La Serena',
        addressCountry: 'CL',
      },
    },
    {
      '@type': 'WebSite',
      '@id': `${siteUrl.href}#sitio`,
      url: siteUrl.href,
      name: site.name,
      description: site.description,
      inLanguage: 'es',
      author: { '@id': personId },
    },
    ...(schema ? [{ ...schema, author: { '@id': personId } }] : []),
  ],
};
---

<!doctype html>
<html lang="es" style={tone ? `--accent: var(--tone-${tone})` : undefined}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="preload" as="font" type="font/woff2" href={archivoLatin} crossorigin="anonymous" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex, follow" /> : <link rel="canonical" href={canonical} />}
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#0c1220" />
    <meta name="author" content={site.name} />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_CL" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {!noindex && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Benjamín Criado — ingeniero informático" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <a class="skip-link" href="#contenido">Saltar al contenido</a>
    <Header />
    <main id="contenido" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <script>
      if (window.matchMedia('(hover: hover) and (pointer: fine)').matches) {
        for (const el of document.querySelectorAll<HTMLElement>('.spot')) {
          el.addEventListener('pointermove', (e) => {
            const r = el.getBoundingClientRect();
            el.style.setProperty('--mx', `${e.clientX - r.left}px`);
            el.style.setProperty('--my', `${e.clientY - r.top}px`);
          });
        }
      }
    </script>
  </body>
</html>
