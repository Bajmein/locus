  .project-card:hover .go,
  .project-card:focus-visible .go {
    text-decoration-color: var(--accent);
  }

  /* Marca de agua: el ícono del proyecto en grande; se anima al pasar el cursor */
  .mark {
    position: absolute;
    right: -2.5rem;
    bottom: -2.5rem;
    width: 15rem;
    height: 15rem;
    color: var(--accent);
    opacity: 0.07;
    transition: opacity 0.4s ease;
    pointer-events: none;
