  /* ---------- Trabajo con agentes ---------- */
  .trail-wrap {
    position: relative;
  }

  .trail {
    position: relative;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0 2rem;
    list-style: none;
    padding: 0;
    margin: 0 0 1.5rem;
  }

  /* Riel y su relleno, a la altura del centro de los puntos */
  .trail::before,
