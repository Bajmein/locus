    .card-item:nth-child(1),
    .card-item:nth-child(2) {
      grid-column: 1 / -1;
    }

    .project-card,
    .is-agentes .project-card {
      min-height: 0;
      padding: 1.5rem;
    }

    .trail {
      grid-template-columns: minmax(0, 1fr);
      gap: 1.75rem;
    }

    .trail::before,
    .trail::after {
      left: 0.5rem;
      right: auto;
      top: 0;
      bottom: 0;
      width: 1px;
      height: auto;
    }

    .trail::after,
