    letter-spacing: -0.02em;
    line-height: 1.1;
  }

  .is-agentes .project-name {
    font-size: clamp(2rem, 3.6vw, 2.75rem);
  }

  .context {
    margin-top: -0.25rem;
  }

  .project-text {
    max-width: 30rem;
    color: var(--muted);
  }

  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
