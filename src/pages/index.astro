---
import Base from '../layouts/Base.astro';
import { site } from '../data/site';
import { projects } from '../data/projects';
import Icon from '../components/Icon.astro';
import ProjectIcon from '../components/ProjectIcon.astro';

const now = [
  {
    label: 'Trabajo',
    text: 'Encargado de TI en un grupo de empresas: sitios web, integraciones, automatización de procesos y agentes de IA.',
  },
  {
    label: 'Herramientas',
    text: 'Desarrollo episteme, memoria persistente para agentes de IA, y fabrik, un flujo de desarrollo guiado por especificaciones.',
  },
  {
    label: 'Producto',
    text: 'Tercera versión de Vigilia, mi sistema de análisis de video en tiempo real.',
  },
];

const experience = [
  {
    date: '2026 — hoy',
    role: 'Encargado de TI',
    org: 'Grupo de empresas (remoto)',
    text: 'Responsable del área de tecnología: desarrollo y mantención de los sitios web, integraciones entre sistemas, automatización de procesos y agentes de IA.',
  },
  {
    date: '2026',
    role: 'Práctica profesional',
    org: 'Desarrollo web y automatización',
  },
  {
    date: '2021 — 2025',
    role: 'Ingeniería en Informática',
    org: 'INACAP',
    text: 'Proyecto de título: Vigilia.',
  },
];

// Trabajo con agentes: cifras de GitHub (commits y PR fusionados) al 16-11-2026
const trail = [
  {
    slug: 'forge',
    name: 'Forge',
    period: 'Abril — julio de 2026',
    text: 'Pipeline guiado por especificaciones: cada cambio avanza por fases con artefactos validados por esquemas, con cualquier agente.',
    figures: '304 commits · 38 PR',
    href: '/forge/',
  },
  {
    name: 'pulse',
    period: 'Mayo — octubre de 2026',
    text: 'Motor de estados servido por MCP: compuertas entre fases, revisión automática y escenarios Dado/Cuando/Entonces, para varios agentes de código.',
    figures: '270 commits · 50 PR',
  },
  {
    name: 'fabrik',
    period: 'Octubre de 2026 — hoy',
    text: 'Plugin de Claude Code: un orquestador con cinco subagentes acotados; los hooks impiden editar sin especificación y cada verificación es un comando.',
    figures: '72 commits · 46 PR',
  },
  {
    slug: 'episteme',
    name: 'episteme',
    period: 'Octubre de 2026 — hoy',
    text: 'Memoria persistente servida por MCP: decisiones y lecciones que el agente consulta y completa en cada sesión.',
    figures: '336 commits · 121 PR',
    href: '/episteme/',
  },
];

const method = [
  {
    title: 'Especificar antes de implementar',
    text: 'Cada cambio parte de una especificación verificable; los agentes ejecutan y los artefactos mandan.',
  },
  {
    title: 'Verificar con comandos',
    text: 'Una tarea está lista cuando un test, el lint o el chequeo de tipos lo demuestra, no cuando el modelo lo afirma.',
  },
  {
    title: 'Memoria que es del usuario',
    text: 'Decisiones y lecciones quedan en notas Markdown locales que cualquier agente puede consultar.',
  },
  {
    title: 'Planes que se ejecutan en limpio',
    text: 'Cada plan lleva sus fuentes, sus decisiones cerradas y su verificación, para que otro agente lo ejecute sin la conversación previa.',
  },
];

const principles = [
  {
    title: 'La herramienta correcta',
    text: 'Rust donde la latencia es crítica, Python para orquestar. La tecnología se elige por el problema.',
  },
  {
    title: 'Local primero',
    text: 'Sistemas que corren en el equipo del usuario, sin depender de la nube ni exponer sus datos.',
  },
  {
    title: 'Las personas deciden',
    text: 'Los agentes proponen y ejecutan; las decisiones de producto y el merge los toma una persona.',
  },
];

const tech = [
  [
    'Agentes de IA',
    'Claude Code, Codex CLI, Gemini CLI, GitHub Copilot; MCP, hooks, skills y subagentes; desarrollo guiado por especificaciones',
  ],
  ['Lenguajes', 'Python, Rust, JavaScript'],
  ['Visión por computador', 'OpenCV, YOLO, TensorRT, CUDA / NVDEC'],
  ['Web', 'WordPress, REST API, HTML y CSS'],
  ['Infraestructura', 'Linux, AWS, Azure'],
];
---

<Base title="Benjamín Criado — Ingeniero Informático" description={site.description}>
  <section class="container hero" aria-labelledby="hero-title">
    <div class="hero-main">
      <p class="label">Ingeniero Informático · Agentes de IA y automatización · La Serena, Chile</p>
      <h1 id="hero-title">Benjamín Criado</h1>
      <p class="lead">Diseño flujos de trabajo con agentes de IA y automatizo procesos:</p>
      <p class="lead-sub">
        desarrollo guiado por especificaciones, memoria persistente para agentes e integraciones entre
        sistemas. También construyo visión por computador en tiempo real, pensada para producción.
      </p>
      <div class="actions">
        <a class="btn btn-primary" href="#agentes">Trabajo con agentes</a>
        <a class="btn" href="/cv/">Currículum</a>
      </div>
    </div>
    <aside class="glass now-panel" aria-labelledby="ahora">
      <h2 id="ahora" class="label"><span class="pulse" aria-hidden="true"></span>Ahora</h2>
      <dl class="now">
        {
          now.map((item) => (
            <div class="now-row">
              <dt class="label">{item.label}</dt>
              <dd>{item.text}</dd>
            </div>
          ))
        }
      </dl>
    </aside>
  </section>

  <section class="container section" id="agentes" aria-labelledby="agentes-title">
    <div class="section-head">
      <p class="label">Trabajo con agentes</p>
      <h2 id="agentes-title">De la especificación a la memoria</h2>
    </div>
    <p class="intro muted">
      Desde abril de 2026 construyo las herramientas con que trabajo con agentes de código. Cada una resolvió lo
      que la anterior dejaba abierto.
    </p>
    <ol class="trail">
      {
        trail.map((t) => (
          <li class="step reveal" style={t.slug ? `--accent: var(--tone-${t.slug})` : undefined}>
            <span class="dot" aria-hidden="true" />
            <span class="label">{t.period}</span>
            <h3>{t.href ? <a href={t.href}>{t.name}</a> : t.name}</h3>
            <p>{t.text}</p>
            <span class="label figures">{t.figures}</span>
          </li>
        ))
      }
    </ol>
    <p class="label muted source">Cifras de GitHub al 16 de noviembre de 2026.</p>
    <ul class="method">
      {
        method.map((m) => (
          <li class="reveal">
            <h3>{m.title}</h3>
            <p>{m.text}</p>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="container section" id="proyectos" aria-labelledby="proyectos-title">
    <div class="section-head">
      <p class="label">Proyectos</p>
      <h2 id="proyectos-title">Herramientas para agentes y visión por computador</h2>
    </div>
    <ol class="projects">
      {
        projects.map((p) => (
          <li class:list={['card-item', `is-${p.group}`]}>
            <a
              class="project-card glass spot reveal"
              href={`/${p.slug}/`}
              style={`--accent: var(--tone-${p.slug})`}
            >
              <span class="card-top">
                <ProjectIcon slug={p.slug} />
                <span class="go label" aria-hidden="true">Ver proyecto <span class="go-arrow">→</span></span>
              </span>
              <span class="label kind">{p.group === 'agentes' ? 'Agentes de IA' : 'Visión por computador'}</span>
              <span class="project-name" style={`view-transition-name: proyecto-${p.slug}`}>
                {p.title}
              </span>
              <span class="label period">{p.period}</span>
              <span class="project-text">{p.card.text}</span>
              <span class="chips">
                {p.card.stack.map((s) => (
                  <span class="label chip">{s}</span>
                ))}
              </span>
            </a>
          </li>
        ))
      }
    </ol>
  </section>

  <section class="container section lazy" id="experiencia" aria-labelledby="experiencia-title">
    <div class="section-head">
      <p class="label">Experiencia</p>
      <h2 id="experiencia-title">Trayectoria</h2>
    </div>
    <ol class="timeline">
      {
        experience.map((e) => (
          <li class="tl-row">
            <span class="label tl-date">{e.date}</span>
            <div>
              <h3>
                {e.role} <span class="muted">· {e.org}</span>
              </h3>
              {e.text && <p>{e.text}</p>}
            </div>
          </li>
        ))
      }
    </ol>
    <p class="more"><a href="/cv/">Ver currículum completo →</a></p>
  </section>

  <section class="container section lazy" aria-labelledby="enfoque">
    <div class="section-head">
      <p class="label">Enfoque</p>
      <h2 id="enfoque">Cómo decido</h2>
    </div>
    <div class="principles">
      {
        principles.map((p) => (
          <div class="principle">
            <h3>{p.title}</h3>
            <p>{p.text}</p>
          </div>
        ))
      }
    </div>
  </section>

  <section class="container section lazy" aria-labelledby="tecnologias">
    <div class="section-head">
      <p class="label">Tecnologías</p>
      <h2 id="tecnologias">Con qué trabajo</h2>
    </div>
    <div class="table-wrap">
      <table>
        <caption class="sr-only">Tecnologías por área</caption>
        <tbody>
          {
            tech.map(([area, items]) => (
              <tr>
                <th scope="row">{area}</th>
                <td>{items}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
  </section>

  <section class="container section contact lazy" id="contacto" aria-labelledby="contacto-title">
    <div class="section-head">
      <p class="label">Contacto</p>
      <h2 id="contacto-title">Conversemos</h2>
    </div>
    <div class="glass spot contact-panel">
      <div>
        <p class="muted">Disponible para conversar sobre proyectos y colaboraciones.</p>
        <a class="mail" href={`mailto:${site.email}`}><Icon name="mail" />{site.email}</a>
      </div>
      <ul class="social">
        <li><a href={site.github} rel="me"><Icon name="github" />GitHub</a></li>
        <li><a href={site.linkedin} rel="me"><Icon name="linkedin" />LinkedIn</a></li>
      </ul>
    </div>
  </section>
</Base>

<style>
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 0.8fr);
    gap: clamp(2rem, 5vw, 4rem);
    align-items: end;
    padding-block: clamp(4rem, 11vw, 7.5rem) clamp(3.5rem, 9vw, 6rem);
  }

  .hero-main > .label {
    margin-bottom: 1.25rem;
  }

  .hero h1 {
    font-size: clamp(2.75rem, 7vw, 5.25rem);
    font-weight: 600;
    letter-spacing: -0.035em;
    line-height: 1;
    margin-bottom: 1.5rem;
  }

  .lead {
    max-width: 40rem;
    font-size: clamp(1.125rem, 2vw, 1.25rem);
    color: var(--text);
    margin-bottom: 0.75rem;
  }

  .lead-sub {
    max-width: 36rem;
    font-size: clamp(1rem, 1.6vw, 1.0625rem);
    color: var(--muted);
    margin-bottom: 2.25rem;
  }

  /* Ahora */
  .now-panel {
    padding: 1.5rem 1.75rem;
  }

  .now-panel h2 {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin: 0 0 0.5rem;
    color: var(--text);
  }

  .pulse {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--accent);
    animation: pulse 2.4s ease-out infinite;
  }

  @keyframes pulse {
    from {
      box-shadow: 0 0 0 0 color-mix(in srgb, var(--accent) 55%, transparent);
    }

    to {
      box-shadow: 0 0 0 9px transparent;
    }
  }

  .now {
    margin: 0;
  }

  .now-row {
    padding-block: 0.9rem;
    border-top: 1px solid var(--glass-border);
  }

  .now-row dt {
    margin-bottom: 0.25rem;
  }

  .now-row dd {
    margin: 0;
    font-size: 0.9688rem;
  }

  /* Secuencia de entrada: única animación automática de la portada */
  @media (prefers-reduced-motion: no-preference) {
    .hero-main > *,
    .now-panel {
      animation: rise 0.8s var(--ease-out) both;
    }

    .hero-main > :nth-child(2) {
      animation-delay: 0.08s;
    }

    .hero-main > :nth-child(3) {
      animation-delay: 0.16s;
    }

    .hero-main > :nth-child(4) {
      animation-delay: 0.24s;
    }

    .hero-main > :nth-child(5) {
      animation-delay: 0.32s;
    }

    .now-panel {
      animation-delay: 0.4s;
    }
  }

  /* Proyectos */
  .projects {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: 1rem;
  }

  .card-item {
    grid-column: span 6;
    margin: 0;
  }

  .project-card {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    height: 100%;
    min-height: 13rem;
    padding: 1.5rem 1.75rem;
    text-decoration: none;
    color: var(--text);
    transition:
      transform 0.3s var(--ease-out),
      border-color 0.25s ease;
  }

  .project-card:hover,
  .project-card:focus-visible {
    color: var(--text);
    border-color: color-mix(in srgb, var(--accent) 45%, transparent);
    transform: translateY(-3px);
  }

  @media (prefers-reduced-motion: reduce) {
    .project-card:hover,
    .project-card:focus-visible {
      transform: none;
    }
  }

  .is-agentes .project-card {
    min-height: 17rem;
    padding: 1.75rem 2rem;
  }

  .is-agentes .project-name {
    font-size: clamp(1.5rem, 3vw, 2rem);
  }

  .is-vision .project-card {
    min-height: 0;
  }

  .card-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    margin-bottom: 0.25rem;
  }

  .kind {
    color: var(--accent);
    margin-bottom: -0.5rem;
  }

  .period {
    margin-top: -0.5rem;
  }

  .project-name {
    font-size: clamp(1.25rem, 2.5vw, 1.625rem);
    font-weight: 600;
    letter-spacing: -0.015em;
  }

  .project-text {
    color: var(--muted);
    font-size: 0.9688rem;
    max-width: 34rem;
  }

  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: auto;
    padding-top: 0.75rem;
  }

  .chip {
    padding: 0.2rem 0.55rem;
    border: 1px solid var(--glass-border);
    border-radius: 999px;
    font-size: 0.75rem;
  }

  .go {
    color: var(--muted);
    transition: color 0.2s ease;
  }

  .go-arrow {
    display: inline-block;
    transition: transform 0.2s ease;
  }

  .project-card:hover .go,
  .project-card:focus-visible .go {
    color: var(--accent);
  }

  .project-card:hover .go-arrow,
  .project-card:focus-visible .go-arrow {
    transform: translateX(0.25rem);
  }

  @media (prefers-reduced-motion: reduce) {
    .project-card:hover .go-arrow,
    .project-card:focus-visible .go-arrow {
      transform: none;
    }
  }

  /* Trabajo con agentes */
  .intro {
    max-width: var(--w-prose);
    margin-bottom: 2.5rem;
  }

  .trail {
    position: relative;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1.5rem;
    list-style: none;
    padding: 0;
    margin: 0 0 1.25rem;
  }

  /* Riel y riel de progreso, a la altura del centro de los puntos */
  .trail::before,
  .trail::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    top: 0.45rem;
    height: 1px;
    background: var(--border);
  }

  .trail::after {
    background: var(--accent);
    transform-origin: left;
  }

  .step {
    position: relative;
    margin: 0;
    padding-top: 2rem;
  }

  .dot {
    position: absolute;
    top: 0;
    left: 0;
    z-index: 1;
    width: 0.9rem;
    height: 0.9rem;
    border-radius: 50%;
    background: var(--accent);
    transition: transform 0.2s ease;
  }

  .step:not([style]) .dot {
    background: var(--bg);
    border: 2px solid var(--muted);
  }

  .step:hover .dot {
    transform: scale(1.25);
  }

  .step h3 {
    margin: 0.35rem 0 0.5rem;
    font-size: 1.25rem;
  }

  .step h3 a {
    color: var(--accent);
    text-decoration-color: color-mix(in srgb, var(--accent) 40%, transparent);
  }

  .step p {
    color: var(--muted);
    font-size: 0.9375rem;
    margin-bottom: 0.75rem;
  }

  .figures {
    color: var(--text);
  }

  .source {
    margin-bottom: 3rem;
  }

  @keyframes fill {
    from {
      transform: scaleX(0);
    }
  }

  @keyframes fill-y {
    from {
      transform: scaleY(0);
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: view()) {
      .trail::after {
        animation: fill linear both;
      }

      /* Regla aparte: el minificador funde animation-timeline en el atajo animation y lo invalida */
      [class~='trail']::after {
        animation-timeline: view();
        animation-range: entry 20% cover 50%;
      }
    }
  }

  .method {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    list-style: none;
    padding: 0;
    margin: 0;
    border-top: 1px solid var(--border);
  }

  .method li {
    margin: 0;
    padding: 1.5rem 1.75rem 0.5rem 0;
  }

  .method li:nth-child(even) {
    padding-left: 1.75rem;
    border-left: 1px solid var(--border);
  }

  .method li:nth-child(n + 3) {
    border-top: 1px solid var(--border);
  }

  .method p {
    color: var(--muted);
    font-size: 0.9688rem;
  }

  /* Experiencia: riel vertical */
  .timeline {
    list-style: none;
    padding: 0;
    margin: 0 0 2rem;
  }

  .tl-row {
    display: grid;
    grid-template-columns: 11rem minmax(0, 1fr);
    gap: 0 2rem;
    margin: 0;
  }

  .tl-row > div {
    position: relative;
    padding: 0 0 2rem 2rem;
    border-left: 1px solid var(--border);
  }

  .tl-row:last-child > div {
    padding-bottom: 0.25rem;
  }

  .tl-row > div::before {
    content: '';
    position: absolute;
    left: -4px;
    top: 0.5rem;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--border);
  }

  .tl-row:first-child > div::before {
    background: var(--accent);
  }

  .tl-date {
    padding-top: 0.15rem;
  }

  .tl-row h3 {
    margin: 0;
    font-size: 1.0625rem;
  }

  .tl-row h3 .muted {
    font-weight: 400;
  }

  .tl-row p {
    margin: 0.4rem 0 0;
    color: var(--muted);
    max-width: var(--w-prose);
  }

  .more a {
    text-decoration: none;
    color: var(--accent);
  }

  .more a:hover {
    text-decoration: underline;
  }

  /* Enfoque */
  .principles {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    border-top: 1px solid var(--border);
  }

  .principle {
    padding: 1.5rem 1.75rem 0.5rem 0;
  }

  .principle + .principle {
    padding-left: 1.75rem;
    border-left: 1px solid var(--border);
  }

  .principle p {
    color: var(--muted);
    font-size: 0.9688rem;
  }

  /* Tecnologías */
  th[scope='row'] {
    width: 14rem;
    padding-top: 0.95rem;
  }

  td {
    color: var(--text);
    white-space: normal;
  }

  /* Contacto */
  .contact .muted {
    margin-bottom: 0.75rem;
  }

  .mail {
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
    font-size: clamp(1.125rem, 2.5vw, 1.375rem);
    font-weight: 500;
    letter-spacing: -0.01em;
    text-decoration: none;
    margin-bottom: 1.5rem;
  }

  .contact-panel {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: 1.5rem 3rem;
    padding: clamp(1.5rem, 4vw, 2.75rem);
  }

  .contact-panel .mail {
    margin-bottom: 0;
  }

  .social {
    display: flex;
    gap: 1.5rem;
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .social li {
    margin: 0;
  }

  .social a {
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
  }

  @media (max-width: 900px) {
    .hero {
      grid-template-columns: 1fr;
      align-items: start;
    }
  }

  @media (max-width: 760px) {
    .card-item {
      grid-column: 1 / -1;
    }

    .project-card,
    .is-agentes .project-card {
      min-height: 0;
    }

    .trail {
      grid-template-columns: minmax(0, 1fr);
      gap: 1.75rem;
    }

    .trail::before,
    .trail::after {
      left: 0.45rem;
      right: auto;
      top: 0;
      bottom: 0;
      width: 1px;
      height: auto;
    }

    .trail::after {
      transform-origin: top;
      animation-name: fill-y;
    }

    .step {
      padding: 0 0 0 2rem;
    }

    .dot {
      top: 0.3rem;
    }

    .method {
      grid-template-columns: minmax(0, 1fr);
    }

    .method li,
    .method li:nth-child(even) {
      padding: 1.25rem 0 0.25rem;
      border-left: 0;
    }

    .method li + li {
      border-top: 1px solid var(--border);
    }

