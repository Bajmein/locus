      animation: none;
      display: none;
    }

    /* Una columna: sin subgrid, para que no queden huecos entre período, nombre, texto y cifras */
    .step {
      display: flex;
      flex-direction: column;
      grid-row: auto;
      padding: 0 0 0 2rem;
    }

    /* Caja de detección dentro del gutter (su margen en móvil está en global.css) */
    .target {
