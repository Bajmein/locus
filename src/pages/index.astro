  }

  /* ---------- Pantallas angostas: una columna ---------- */
  @media (max-width: 960px) {
    .hero,
    .split,
    .two-col {
      grid-template-columns: minmax(0, 1fr);
    }

    .now-strip {
      grid-template-columns: minmax(0, 1fr);
      gap: 1rem;
    }

    .now {
      grid-template-columns: minmax(0, 1fr);
      gap: 1.25rem;
    }
  }

  @media (max-width: 760px) {
