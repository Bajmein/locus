---
import Base from '../layouts/Base.astro';
import { site } from '../data/site';
import { projects } from '../data/projects';
import Icon from '../components/Icon.astro';

const now = [
  {
    label: 'Trabajo',
    text: 'Encargado de TI en un grupo de empresas: sitios web, integraciones, automatización de procesos y agentes de IA.',
  },
  {
    label: 'Herramientas',
    text: 'Desarrollo episteme, memoria persistente para agentes de IA, y fabrik, un flujo de desarrollo guiado por especificaciones.',
  },
  {
    label: 'Producto',
    text: 'Tercera versión de Vigilia, mi sistema de análisis de video en tiempo real.',
  },
];

const experience = [
  {
    date: '2026 — hoy',
    role: 'Encargado de TI',
    org: 'Grupo de empresas (remoto)',
    text: 'Responsable del área de tecnología: desarrollo y mantención de los sitios web, integraciones entre sistemas, automatización de procesos y agentes de IA.',
  },
  {
    date: '2026',
    role: 'Práctica profesional',
    org: 'Desarrollo web y automatización',
  },
  {
    date: '2021 — 2025',
    role: 'Ingeniería en Informática',
    org: 'INACAP',
    text: 'Proyecto de título: Vigilia.',
  },
];

const principles = [
  {
    title: 'La herramienta correcta',
    text: 'Rust donde la latencia es crítica, Python para orquestar. La tecnología se elige por el problema.',
  },
  {
    title: 'Especificar antes de implementar',
    text: 'Cada cambio parte de una especificación verificable; los agentes ejecutan, los artefactos mandan.',
  },
  {
    title: 'Local primero',
    text: 'Sistemas que corren en el equipo del usuario, sin depender de la nube ni exponer sus datos.',
  },
];

const tech = [
  ['Lenguajes', 'Python, Rust, JavaScript'],
  ['Visión por computador', 'OpenCV, YOLO, TensorRT, CUDA / NVDEC'],
  ['IA aplicada', 'Agentes, Model Context Protocol (MCP), desarrollo guiado por especificaciones'],
  ['Web', 'WordPress, REST API, HTML y CSS'],
  ['Infraestructura', 'Linux, AWS, Azure'],
];
---

<Base title="Benjamín Criado — Ingeniero Informático" description={site.description}>
  <section class="container hero" aria-labelledby="hero-title">
    <div class="hero-main">
      <p class="label">Ingeniero Informático · La Serena, Chile</p>
      <h1 id="hero-title">Benjamín Criado</h1>
      <p class="lead">
        Desarrollo software y automatización con inteligencia artificial. Construyo sistemas de visión por
        computador en tiempo real, integraciones y herramientas para trabajar con agentes, pensados para
        funcionar en producción.
      </p>
      <div class="actions">
        <a class="btn btn-primary" href="#proyectos">Ver proyectos</a>
        <a class="btn" href="/cv/">Currículum</a>
      </div>
    </div>
    <aside class="glass now-panel" aria-labelledby="ahora">
      <h2 id="ahora" class="label"><span class="pulse" aria-hidden="true"></span>Ahora</h2>
      <dl class="now">
        {
          now.map((item) => (
            <div class="now-row">
              <dt class="label">{item.label}</dt>
              <dd>{item.text}</dd>
            </div>
          ))
        }
      </dl>
    </aside>
  </section>

  <section class="container section" id="proyectos" aria-labelledby="proyectos-title">
    <div class="section-head">
      <h2 id="proyectos-title">Proyectos</h2>
    </div>
    <ol class="projects">
      {
        projects.map((p) => (
          <li>
            <a class="project-card glass spot reveal" href={`/${p.slug}/`}>
              <span class="card-top">
                <span class="project-name" style={`view-transition-name: proyecto-${p.slug}`}>
                  {p.title}
                </span>
                <span class="arrow" aria-hidden="true">→</span>
              </span>
              <span class="project-text">{p.card.text}</span>
              <span class="chips">
                {p.card.stack.map((s) => (
                  <span class="label chip">{s}</span>
                ))}
              </span>
            </a>
          </li>
        ))
      }
    </ol>
  </section>

  <section class="container section" id="experiencia" aria-labelledby="experiencia-title">
    <div class="section-head">
      <h2 id="experiencia-title">Experiencia</h2>
    </div>
    <ol class="timeline">
      {
        experience.map((e) => (
          <li class="tl-row">
            <span class="label tl-date">{e.date}</span>
            <div>
              <h3>
                {e.role} <span class="muted">· {e.org}</span>
              </h3>
              {e.text && <p>{e.text}</p>}
            </div>
          </li>
        ))
      }
    </ol>
    <p class="more"><a href="/cv/">Ver currículum completo →</a></p>
  </section>

  <section class="container section" aria-labelledby="enfoque">
    <div class="section-head">
      <h2 id="enfoque">Enfoque</h2>
    </div>
    <div class="principles">
      {
        principles.map((p) => (
          <div class="principle">
            <h3>{p.title}</h3>
            <p>{p.text}</p>
          </div>
        ))
      }
    </div>
  </section>

  <section class="container section" aria-labelledby="tecnologias">
    <div class="section-head">
      <h2 id="tecnologias">Tecnologías</h2>
    </div>
    <div class="table-wrap">
      <table>
        <caption class="sr-only">Tecnologías por área</caption>
        <tbody>
          {
            tech.map(([area, items]) => (
              <tr>
                <th scope="row">{area}</th>
                <td>{items}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
  </section>

  <section class="container section contact" id="contacto" aria-labelledby="contacto-title">
    <div class="section-head">
      <h2 id="contacto-title">Contacto</h2>
    </div>
    <div class="glass spot contact-panel">
      <div>
        <p class="muted">Disponible para conversar sobre proyectos y colaboraciones.</p>
        <a class="mail" href={`mailto:${site.email}`}><Icon name="mail" />{site.email}</a>
      </div>
      <ul class="social">
        <li><a href={site.github} rel="me"><Icon name="github" />GitHub</a></li>
        <li><a href={site.linkedin} rel="me"><Icon name="linkedin" />LinkedIn</a></li>
      </ul>
    </div>
  </section>
</Base>

<style>
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 0.8fr);
    gap: clamp(2rem, 5vw, 4rem);
    align-items: end;
    padding-block: clamp(4rem, 11vw, 7.5rem) clamp(3.5rem, 9vw, 6rem);
  }

  .hero-main > .label {
    margin-bottom: 1.25rem;
  }

  .hero h1 {
    font-size: clamp(2.75rem, 7vw, 5.25rem);
    font-weight: 600;
    letter-spacing: -0.035em;
    line-height: 1;
    margin-bottom: 1.5rem;
  }

  .lead {
    max-width: 40rem;
    font-size: clamp(1.125rem, 2vw, 1.25rem);
    color: var(--muted);
    margin-bottom: 2.25rem;
  }

  /* Ahora */
  .now-panel {
    padding: 1.5rem 1.75rem;
  }

  .now-panel h2 {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin: 0 0 0.5rem;
    color: var(--text);
  }

  .pulse {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--accent);
    animation: pulse 2.4s ease-out infinite;
  }

  @keyframes pulse {
    from {
      box-shadow: 0 0 0 0 color-mix(in srgb, var(--accent) 55%, transparent);
    }

    to {
      box-shadow: 0 0 0 9px transparent;
    }
  }

  .now {
    margin: 0;
  }

  .now-row {
    padding-block: 0.9rem;
    border-top: 1px solid var(--glass-border);
  }

  .now-row dt {
    margin-bottom: 0.25rem;
  }

  .now-row dd {
    margin: 0;
    font-size: 0.9688rem;
  }

  /* Secuencia de entrada: única animación automática de la portada */
  @media (prefers-reduced-motion: no-preference) {
    .hero-main > *,
    .now-panel {
      animation: rise 0.8s var(--ease-out) both;
    }

    .hero-main > :nth-child(2) {
      animation-delay: 0.08s;
    }

    .hero-main > :nth-child(3) {
      animation-delay: 0.16s;
    }

    .hero-main > :nth-child(4) {
      animation-delay: 0.24s;
    }

    .now-panel {
      animation-delay: 0.36s;
    }
  }

  /* Proyectos */
  .projects {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: 1rem;
  }

  .projects li {
    margin: 0;
    grid-column: span 5;
  }

  .projects li:nth-child(4n + 1),
  .projects li:nth-child(4n) {
    grid-column: span 7;
  }

  .project-card {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    height: 100%;
    min-height: 13rem;
    padding: 1.5rem 1.75rem;
    text-decoration: none;
    color: var(--text);
    transition: border-color 0.25s ease;
  }

  .project-card:hover,
  .project-card:focus-visible {
    color: var(--text);
    border-color: color-mix(in srgb, var(--accent) 45%, transparent);
  }

  .card-top {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
  }

  .project-name {
    font-size: clamp(1.25rem, 2.5vw, 1.625rem);
    font-weight: 600;
    letter-spacing: -0.015em;
  }

  .project-text {
    color: var(--muted);
    font-size: 0.9688rem;
    max-width: 34rem;
  }

  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: auto;
    padding-top: 0.75rem;
  }

  .chip {
    padding: 0.2rem 0.55rem;
    border: 1px solid var(--glass-border);
    border-radius: 999px;
    font-size: 0.75rem;
  }

  .arrow {
    color: var(--muted);
    transition: color 0.2s ease, transform 0.2s ease;
  }

  .project-card:hover .arrow,
  .project-card:focus-visible .arrow {
    color: var(--accent);
    transform: translateX(0.25rem);
  }

  /* Experiencia: riel vertical */
  .timeline {
    list-style: none;
    padding: 0;
    margin: 0 0 2rem;
  }

  .tl-row {
    display: grid;
    grid-template-columns: 11rem minmax(0, 1fr);
    gap: 0 2rem;
    margin: 0;
  }

  .tl-row > div {
    position: relative;
    padding: 0 0 2rem 2rem;
    border-left: 1px solid var(--border);
  }

  .tl-row:last-child > div {
    padding-bottom: 0.25rem;
  }

  .tl-row > div::before {
    content: '';
    position: absolute;
    left: -4px;
    top: 0.5rem;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--border);
  }

  .tl-row:first-child > div::before {
    background: var(--accent);
  }

  .tl-date {
    padding-top: 0.15rem;
  }

  .tl-row h3 {
    margin: 0;
    font-size: 1.0625rem;
  }

  .tl-row h3 .muted {
    font-weight: 400;
  }

  .tl-row p {
    margin: 0.4rem 0 0;
    color: var(--muted);
    max-width: var(--w-prose);
  }

  .more a {
    text-decoration: none;
    color: var(--accent);
  }

  .more a:hover {
    text-decoration: underline;
  }

  /* Enfoque */
  .principles {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    border-top: 1px solid var(--border);
  }

  .principle {
    padding: 1.5rem 1.75rem 0.5rem 0;
  }

  .principle + .principle {
    padding-left: 1.75rem;
    border-left: 1px solid var(--border);
  }

  .principle p {
    color: var(--muted);
    font-size: 0.9688rem;
  }

  /* Tecnologías */
  th[scope='row'] {
    width: 14rem;
    padding-top: 0.95rem;
  }

  td {
    color: var(--text);
    white-space: normal;
  }

  /* Contacto */
  .contact .muted {
    margin-bottom: 0.75rem;
  }

  .mail {
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
    font-size: clamp(1.125rem, 2.5vw, 1.375rem);
    font-weight: 500;
    letter-spacing: -0.01em;
    text-decoration: none;
    margin-bottom: 1.5rem;
  }

  .contact-panel {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: 1.5rem 3rem;
    padding: clamp(1.5rem, 4vw, 2.75rem);
  }

  .contact-panel .mail {
    margin-bottom: 0;
  }

  .social {
    display: flex;
    gap: 1.5rem;
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .social li {
    margin: 0;
  }

  .social a {
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
  }

  @media (max-width: 900px) {
    .hero {
      grid-template-columns: 1fr;
      align-items: start;
    }
  }

  @media (max-width: 760px) {
    .projects li,
    .projects li:nth-child(4n + 1),
    .projects li:nth-child(4n) {
      grid-column: 1 / -1;
    }

    .project-card {
      min-height: 0;
    }

    .principles {
      grid-template-columns: 1fr;
    }

    .principle,
    .principle + .principle {
      padding: 1.25rem 0 0.25rem;
      border-left: 0;
    }

    .principle + .principle {
      border-top: 1px solid var(--border);
    }
  }

  @media (max-width: 640px) {
    .tl-row {
      grid-template-columns: 1fr;
    }

    .tl-date {
      padding: 0 0 0.4rem 2rem;
      border-left: 1px solid var(--border);
    }

    th[scope='row'] {
      width: 9rem;
    }
  }
</style>
