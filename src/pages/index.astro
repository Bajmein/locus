    gap: 0.85rem;
    padding: 1.75rem 2rem;
  }

  .contact-card.is-primary {
    border-color: color-mix(in srgb, var(--accent) 32%, var(--glass-border));
  }

  .contact-card .label:first-child {
    margin: 0;
    color: var(--accent);
  }

  .contact-card .muted {
    margin: 0;
    font-size: 0.9688rem;
  }

  .mail {
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
    font-size: clamp(1.1875rem, 2.2vw, 1.5rem);
    font-weight: 600;
    letter-spacing: -0.01em;
    text-decoration-color: color-mix(in srgb, var(--accent) 45%, transparent);
  }

  .contact-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1rem;
    margin-top: auto;
    padding-top: 0.5rem;
  }

  .copy {
    font-family: inherit;
    cursor: pointer;
  }

  .copy[hidden] {
    display: none;
  }

  .copy-status {
    min-height: 1em;
  }

  /* ---------- Pantallas angostas: una columna ---------- */
  @media (max-width: 960px) {
    .hero,
    .split,
    .two-col,
    .areas-grid,
    .contact-lanes {
      grid-template-columns: minmax(0, 1fr);
    }

    .card-preview {
      display: none;
    }

    .now-strip {
      grid-template-columns: minmax(0, 1fr);
      gap: 1rem;
    }

    .now {
      grid-template-columns: minmax(0, 1fr);
      gap: 1.25rem;
    }

    .now-row + .now-row {
      padding-left: 0;
      padding-top: 1.1rem;
      border-left: 0;
      border-top: 1px solid var(--glass-border);
    }
  }

  @media (max-width: 760px) {
    .card-item,
    .card-item:nth-child(1),
    .card-item:nth-child(2) {
      grid-column: 1 / -1;
    }

    .project-card,
    .is-agentes .project-card {
      min-height: 0;
      padding: 1.5rem;
    }

    .card-badge {
      margin-left: 0;
    }

    .trail {
      grid-template-columns: minmax(0, 1fr);
      gap: 1.75rem;
    }

    .trail::before,
    .trail::after {
      left: 0.5rem;
      right: auto;
      top: 0;
      bottom: 0;
      width: 1px;
      height: auto;
    }

    /* Relleno vertical del riel: baja con el scroll */
    .trail::after {
      transform-origin: top;
    }

    .token {
      animation: none;
      display: none;
    }

    /* Una columna: sin subgrid, para que no queden huecos entre período, nombre, texto y cifras */
    .step {
      display: flex;
      flex-direction: column;
      grid-row: auto;
      padding: 0 0 0 2rem;
    }

    /* Caja de detección dentro del gutter (su margen en móvil está en global.css) */
    .target {
      margin-left: 0.75rem;
    }

    .dot {
      top: 0.3rem;
    }

    .method {
      grid-template-columns: minmax(0, 1fr);
    }

    .method li,
    .method li:not(:nth-child(3n + 1)) {
      padding: 1.25rem 0 0.25rem;
      border-left: 0;
    }

    .console {
      padding: 1.15rem 1.15rem 1.35rem;
    }

    .log li {
      grid-template-columns: 6.5rem minmax(0, 1fr) auto;
      gap: 0.5rem;
      font-size: 0.8125rem;
    }

    .verb .idx {
      display: none;
    }

    .what {
      font-size: 0.8125rem;
    }

    .contact-card {
      padding: 1.5rem;
    }

    .tl-row,
    .tech div {
      grid-template-columns: minmax(0, 1fr);
      gap: 0.25rem;
    }

    .tl-date {
      padding: 0 0 0.4rem 1.75rem;
      border-left: 1px solid var(--border);
    }
  }
</style>

<script>
  // Riel de #agentes en escritorio: se arma vacío y se llena una vez al entrar en pantalla (CSS en .is-armed)
  const trailWrap = document.querySelector<HTMLElement>('.trail-wrap');
  if (
    trailWrap &&
    'IntersectionObserver' in window &&
    window.matchMedia('(prefers-reduced-motion: no-preference)').matches
  ) {
    trailWrap.classList.add('is-armed');
    const observer = new IntersectionObserver(
      (entries) => {
        if (!entries.some((e) => e.isIntersecting)) return;
        trailWrap.classList.add('is-in');
        observer.disconnect();
      },
      { rootMargin: '0px 0px -20% 0px', threshold: 0.5 },
    );
    observer.observe(trailWrap);
  }

  const button = document.querySelector<HTMLButtonElement>('#contacto [data-copy]');
  const status = document.querySelector<HTMLElement>('#contacto .copy-status');
  if (button && status && navigator.clipboard) {
    let timer: number | undefined;
    button.hidden = false;
    button.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(button.dataset.copy ?? '');
        status.textContent = 'Copiado';
      } catch {
        status.textContent = 'No se pudo copiar';
      }
      window.clearTimeout(timer);
      timer = window.setTimeout(() => {
        status.textContent = '';
      }, 2000);
    });
  }
</script>
