  }

  .mark :global(.project-icon) {
    width: 100%;
    height: 100%;
  }

  .project-card:hover .mark,
  .project-card:focus-visible .mark {
    opacity: 0.22;
  }

  /* ---------- Trabajo con agentes ---------- */
  .trail-wrap {
    position: relative;
  }

  .trail {
    position: relative;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0 2rem;
    list-style: none;
    padding: 0;
    margin: 0 0 1.5rem;
  }

  /* Riel y su relleno, a la altura del centro de los puntos */
  .trail::before,
  .trail::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    top: 0.5rem;
    height: 1px;
    background: var(--border);
  }

  .trail::after {
    background: var(--accent);
    transform-origin: left;
  }

  /* Ficha que viaja por el riel con el scroll, como el token de Forge */
  .token {
    position: absolute;
    top: 0.5rem;
    left: 0;
    right: 0;
    z-index: 2;
    height: 0;
    pointer-events: none;
    display: none;
  }

  .token::after {
    content: '';
    position: absolute;
    left: -0.4rem;
    top: -0.4rem;
    width: 0.8rem;
    height: 0.8rem;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 0 5px color-mix(in srgb, var(--accent) 22%, transparent);
  }

  /* Subgrid: período, nombre, texto, cifras y nota quedan alineados entre los cuatro pasos */
  .step {
    position: relative;
    margin: 0;
    padding-top: 2.25rem;
    display: grid;
    grid-row: span 5;
    grid-template-rows: subgrid;
    align-content: start;
  }

  .dot {
    position: absolute;
    top: 0;
    left: 0;
    z-index: 1;
    width: 1rem;
    height: 1rem;
    border-radius: 50%;
    background: var(--accent);
    border: 3px solid var(--bg);
    transition: transform 0.2s ease;
  }

  .step:not([style]) .dot {
    background: var(--bg);
    border: 2px solid var(--muted);
  }

  .step:hover .dot {
    transform: scale(1.25);
  }

  .step h3 {
    margin: 0.3rem 0 0.5rem;
    font-size: 1.5rem;
    font-family: var(--font-display);
    font-stretch: 112%;
    font-weight: 700;
  }

  .step h3 a {
    color: var(--accent);
    text-decoration-color: color-mix(in srgb, var(--accent) 40%, transparent);
  }

  .step p {
    color: var(--muted);
    font-size: 0.9688rem;
    margin-bottom: 1rem;
  }

  .figures {
    color: var(--text);
  }

  .nopage {
    margin-top: 0.35rem;
    font-size: 0.8125rem;
  }

  .source {
    margin-bottom: 4rem;
    font-size: 0.8125rem;
  }

  @keyframes fill {
    from {
      transform: scaleX(0);
    }
  }

  @keyframes travel {
    from {
      transform: translateX(0);
    }

    to {
      transform: translateX(100%);
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: view()) {
      .trail::after {
        animation: fill linear both;
      }

      .token {
        display: block;
        animation: travel linear both;
      }

      /* Regla aparte: el minificador funde animation-timeline en el atajo animation y lo invalida */
      [class~='trail']::after,
      [class~='token'] {
        animation-timeline: view();
        animation-range: entry 30% cover 55%;
      }
    }
  }

  .method-title {
    margin-bottom: 1.25rem;
