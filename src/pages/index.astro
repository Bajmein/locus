---
import Base from '../layouts/Base.astro';
import { site } from '../data/site';
import { projects } from '../data/projects';
import Icon from '../components/Icon.astro';
import ProjectIcon from '../components/ProjectIcon.astro';

const now = [
  {
    label: 'Trabajo',
    text: 'Encargado de TI en un grupo de empresas: sitios web, integraciones, automatización de procesos y agentes de IA.',
  },
  {
    label: 'Herramientas',
    text: 'Desarrollo episteme, memoria persistente para agentes de IA, y fabrik, un flujo de desarrollo guiado por especificaciones.',
  },
  {
    label: 'Producto',
    text: 'Tercera versión de Vigilia, mi sistema de análisis de video en tiempo real.',
  },
];

const experience = [
  {
    date: '2026 — hoy',
    role: 'Encargado de TI',
    org: 'Grupo de empresas (remoto)',
    text: 'Responsable del área de tecnología: desarrollo y mantención de los sitios web, integraciones entre sistemas, automatización de procesos y agentes de IA.',
  },
  {
    date: '2026',
    role: 'Práctica profesional',
    org: 'Desarrollo web y automatización',
  },
  {
    date: '2021 — 2025',
    role: 'Ingeniería en Informática',
    org: 'INACAP',
    text: 'Proyecto de título: Vigilia.',
  },
];

// Trabajo con agentes: cifras de GitHub (commits y PR fusionados) al 16-11-2026
const trail = [
  {
    slug: 'forge',
    name: 'Forge',
    period: 'Abril — julio de 2026',
    text: 'Pipeline guiado por especificaciones: cada cambio avanza por fases con artefactos validados por esquemas, con cualquier agente.',
    commits: 304,
    prs: 38,
    href: '/forge/',
  },
  {
    name: 'pulse',
    period: 'Mayo — octubre de 2026',
    text: 'Motor de estados servido por MCP: compuertas entre fases, revisión automática y escenarios Dado/Cuando/Entonces, para varios agentes de código.',
    commits: 270,
    prs: 50,
  },
  {
    name: 'fabrik',
    period: 'Octubre de 2026 — hoy',
    text: 'Plugin de Claude Code: un orquestador con cinco subagentes acotados; los hooks impiden editar sin especificación y cada verificación es un comando.',
    commits: 72,
    prs: 46,
  },
  {
    slug: 'episteme',
    name: 'episteme',
    period: 'Octubre de 2026 — hoy',
    text: 'Memoria persistente servida por MCP: decisiones y lecciones que el agente consulta y completa en cada sesión.',
    commits: 336,
    prs: 121,
    href: '/episteme/',
  },
];

const method = [
  {
    title: 'Especificar antes de implementar',
    text: 'Cada cambio parte de una especificación verificable; los agentes ejecutan y los artefactos mandan.',
  },
  {
    title: 'Verificar con comandos',
    text: 'Una tarea está lista cuando un test, el lint o el chequeo de tipos lo demuestra, no cuando el modelo lo afirma.',
  },
  {
    title: 'Memoria que es del usuario',
    text: 'Decisiones y lecciones quedan en notas Markdown locales que cualquier agente puede consultar.',
  },
  {
    title: 'Planes que se ejecutan en limpio',
    text: 'Cada plan lleva sus fuentes, sus decisiones cerradas y su verificación, para que otro agente lo ejecute sin la conversación previa.',
  },
  {
    title: 'Las personas deciden',
    text: 'Los agentes proponen y ejecutan; las decisiones de producto y el merge los toma una persona.',
  },
  {
    title: 'La herramienta correcta',
    text: 'Rust donde la latencia es crítica, Python para orquestar. La tecnología se elige por el problema.',
  },
];

const tech = [
  [
    'Agentes de IA',
    'Claude Code, Codex CLI, Gemini CLI, GitHub Copilot; MCP, hooks, skills y subagentes; desarrollo guiado por especificaciones',
  ],
  ['Lenguajes', 'Python, Rust, JavaScript'],
  ['Visión por computador', 'OpenCV, YOLO, TensorRT, CUDA / NVDEC'],
  ['Web', 'WordPress, REST API, HTML y CSS'],
  ['Infraestructura', 'Linux, AWS, Azure'],
];
const totalCommits = trail.reduce((n, t) => n + t.commits, 0);
const totalPrs = trail.reduce((n, t) => n + t.prs, 0);

// Ciclo de un cambio (consola del hero): el método de fabrik y episteme, sin cifras inventadas
const cycle = [
  { verb: 'especificar', text: 'Especificación verificable', state: 'ok' },
  { verb: 'planificar', text: 'Fuentes y decisiones cerradas', state: 'ok' },
  { verb: 'implementar', text: 'Subagentes con tareas acotadas', state: 'ok' },
  { verb: 'verificar', text: 'Tests, lint y tipos en verde', state: 'ok' },
  { verb: 'recordar', text: 'Decisión guardada en episteme', state: 'ok' },
  { verb: 'fusionar', text: 'Lo decide una persona', state: 'espera' },
];

const kind = { agentes: 'Agentes de IA', vision: 'Visión por computador' } as const;
---

<Base title="Benjamín Criado — Ingeniero Informático" description={site.description}>
  <section class="container hero" aria-labelledby="hero-title">
    <div class="hero-main">
      <p class="label eyebrow">Ingeniero informático · Agentes de IA y automatización · La Serena, Chile</p>
      <div class="target">
        <h1 id="hero-title" class="name"><span>Benjamín</span> <span>Criado</span></h1>
        <span class="bbox" aria-hidden="true">
          <i></i><i></i><i></i><i></i>
          <b class="mono">persona 0,99</b>
        </span>
      </div>
      <p class="lead">Diseño flujos de trabajo con agentes de IA y automatizo procesos.</p>
      <p class="lead-sub">
        Desarrollo guiado por especificaciones, memoria persistente para agentes e integraciones entre
        sistemas. También construyo visión por computador en tiempo real, pensada para producción.
      </p>
      <div class="actions">
        <a class="btn btn-primary" href="#proyectos">Ver proyectos</a>
        <a class="btn" href="/cv/">Currículum</a>
      </div>
    </div>

    <figure class="console" aria-labelledby="ciclo">
      <figcaption id="ciclo">
        <span>Ciclo de un cambio</span>
        <span class="mono muted">fabrik + episteme</span>
      </figcaption>
      <ol class="log mono">
        {
          cycle.map((c, i) => (
            <li class={`is-${c.state}`} style={`--i: ${i}`}>
              <span class="verb">{c.verb}</span>
              <span class="what">{c.text}</span>
              <span class="state">{c.state}</span>
            </li>
          ))
        }
      </ol>
      <div class="meter" aria-hidden="true"><span></span></div>
    </figure>
  </section>

  <section class="container now-strip" aria-labelledby="ahora">
    <h2 id="ahora" class="label"><span class="pulse" aria-hidden="true"></span>Ahora</h2>
    <dl class="now">
      {
        now.map((item) => (
          <div class="now-row">
            <dt class="label">{item.label}</dt>
            <dd>{item.text}</dd>
          </div>
        ))
      }
    </dl>
  </section>

  <section class="container section" id="proyectos" aria-labelledby="proyectos-title">
    <div class="section-head split">
      <div>
        <p class="label">Agentes de IA y visión por computador</p>
        <h2 id="proyectos-title">Proyectos</h2>
      </div>
      <p class="muted">
        Herramientas para trabajar con agentes de IA y sistemas de visión por computador que corren en tiempo
        real.
      </p>
    </div>
    <ol class="projects">
      {
        projects.map((p) => (
          <li class:list={['card-item', `is-${p.group}`]}>
            <a class="project-card spot" href={`/${p.slug}/`} style={`--accent: var(--tone-${p.slug})`}>
              <span class="card-top">
                <ProjectIcon slug={p.slug} />
                <span class="label kind">{kind[p.group]}</span>
              </span>
              <span class="project-name" style={`view-transition-name: proyecto-${p.slug}`}>
                {p.title}
              </span>
              <span class="label context">{p.card.context ?? p.period}</span>
              <span class="project-text">{p.card.text}</span>
              <span class="chips">
                {p.card.stack.map((s) => (
                  <span class="mono chip">{s}</span>
                ))}
              </span>
              <span class="go" aria-hidden="true">Ver proyecto</span>
              <span class="mark">
                <ProjectIcon slug={p.slug} size="xl" />
              </span>
            </a>
          </li>
        ))
      }
    </ol>
  </section>

  <section class="container section" id="agentes" aria-labelledby="agentes-title">
    <div class="section-head split">
      <div>
        <p class="label">Trabajo con agentes</p>
        <h2 id="agentes-title">De la especificación a la memoria</h2>
      </div>
      <p class="muted">
        Desde abril de 2026 construyo las herramientas con que trabajo con agentes de código. Cada una resolvió
        lo que la anterior dejaba abierto: entre las cuatro suman <strong>{totalCommits} commits</strong> y
        <strong>{totalPrs} pull requests</strong> fusionados.
      </p>
    </div>
    <div class="trail-wrap">
      <span class="token" aria-hidden="true"></span>
      <ol class="trail">
        {
          trail.map((t) => (
            <li class="step" style={t.slug ? `--accent: var(--tone-${t.slug})` : undefined}>
              <span class="dot" aria-hidden="true" />
              <span class="label">{t.period}</span>
              <h3>{t.href ? <a href={t.href}>{t.name}</a> : t.name}</h3>
              <p>{t.text}</p>
              <span class="mono figures">
                {t.commits} commits, {t.prs} PR
              </span>
              {!t.href && <span class="label nopage">Sin página propia</span>}
            </li>
          ))
        }
      </ol>
    </div>
    <p class="label source">Cifras de GitHub al 16 de noviembre de 2026.</p>
    <h3 class="method-title">Método</h3>
    <ul class="method">
      {
        method.map((m) => (
          <li>
            <h4>{m.title}</h4>
            <p>{m.text}</p>
          </li>
        ))
      }
    </ul>
  </section>

  <div class="container section two-col lazy">
    <section id="experiencia" aria-labelledby="experiencia-title">
      <div class="section-head">
        <p class="label">Experiencia</p>
        <h2 id="experiencia-title">Trayectoria</h2>
      </div>
      <ol class="timeline">
        {
          experience.map((e) => (
            <li class="tl-row">
              <span class="label tl-date">{e.date}</span>
              <div>
                <h3>{e.role}</h3>
                <p class="org">{e.org}</p>
                {e.text && <p>{e.text}</p>}
              </div>
            </li>
          ))
        }
      </ol>
      <p class="more"><a href="/cv/">Ver currículum completo</a></p>
    </section>

    <section aria-labelledby="tecnologias">
      <div class="section-head">
        <p class="label">Tecnologías</p>
        <h2 id="tecnologias">Con qué trabajo</h2>
      </div>
      <dl class="tech">
        {
          tech.map(([area, items]) => (
            <div>
              <dt class="label">{area}</dt>
              <dd>{items}</dd>
            </div>
          ))
        }
      </dl>
    </section>
  </div>

  <section class="container section contact lazy" id="contacto" aria-labelledby="contacto-title">
    <div class="section-head contact-head">
      <p class="label">Contacto</p>
      <h2 id="contacto-title" class="contact-title">Conversemos</h2>
    </div>
    <div class="contact-row">
      <div>
        <p class="muted">Disponible para conversar sobre proyectos y colaboraciones.</p>
        <a class="mail" href={`mailto:${site.email}`}><Icon name="mail" />{site.email}</a>
      </div>
      <div class="contact-actions">
        <button type="button" class="btn copy" data-copy={site.email} hidden>Copiar correo</button>
        <a class="btn" href="/assets/pdf/cv_benjamin_criado.pdf" download>Descargar CV (PDF)</a>
        <span class="label copy-status" role="status" aria-live="polite"></span>
      </div>
    </div>
  </section>
</Base>

<style>
  /* ---------- Hero: el nombre como objeto detectado ---------- */
  .hero {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(0, 0.95fr);
    gap: clamp(2rem, 5vw, 5rem);
    align-items: center;
    padding-block: clamp(3.5rem, 7vw, 5.5rem) clamp(3rem, 6vw, 4.5rem);
  }

  /* Línea de barrido: recorre el hero una vez al cargar, como un sensor */
  .hero::after {
    content: '';
    position: absolute;
    left: var(--gutter);
    right: var(--gutter);
    top: 0;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--accent) 30%, var(--accent) 70%, transparent);
    box-shadow: 0 0 18px 2px color-mix(in srgb, var(--accent) 45%, transparent);
    opacity: 0;
    pointer-events: none;
  }

  .eyebrow {
    margin-bottom: 3.5rem;
    font-weight: 500;
    color: var(--muted);
  }

  .target {
    position: relative;
    display: inline-block;
    margin-bottom: 2.25rem;
  }

  .name {
    margin: 0;
    font-size: clamp(3.5rem, 7.6vw, 7rem);
    font-weight: 800;
    font-family: var(--font-display);
    font-stretch: 112%;
    letter-spacing: -0.035em;
    line-height: 0.92;
  }

  .name span {
    display: block;
  }

  /* Caja de detección: cuatro esquinas y la etiqueta de clase con su confianza */
  .bbox {
    position: absolute;
    inset: -1rem -1.25rem -1.1rem -1.25rem;
    border: 1px solid color-mix(in srgb, var(--accent) 22%, transparent);
    pointer-events: none;
  }

  .bbox i {
    position: absolute;
    width: 1.25rem;
    height: 1.25rem;
    border: 2px solid var(--accent);
  }

  .bbox i:nth-child(1) {
    top: -1px;
    left: -1px;
    border-width: 2px 0 0 2px;
  }

  .bbox i:nth-child(2) {
    top: -1px;
    right: -1px;
    border-width: 2px 2px 0 0;
  }

  .bbox i:nth-child(3) {
    bottom: -1px;
    right: -1px;
    border-width: 0 2px 2px 0;
  }

  .bbox i:nth-child(4) {
    bottom: -1px;
    left: -1px;
    border-width: 0 0 2px 2px;
  }

  .bbox b {
    position: absolute;
    left: -1px;
    bottom: 100%;
    padding: 0.15rem 0.5rem;
    background: var(--accent);
    color: var(--accent-ink);
    font-size: 0.8125rem;
    font-weight: 600;
    white-space: nowrap;
  }

  .lead {
    max-width: 34rem;
    font-size: clamp(1.25rem, 2vw, 1.5rem);
    font-weight: 500;
    line-height: 1.4;
    color: var(--text);
    margin-bottom: 0.9rem;
  }

  .lead-sub {
    max-width: 36rem;
    color: var(--muted);
    margin-bottom: 2.25rem;
  }

  /* Consola: el método como un registro que avanza */
  .console {
    margin: 0;
    padding: 1.5rem 1.75rem 1.75rem;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
  }

  .console figcaption {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    padding-bottom: 1rem;
    margin-bottom: 0.5rem;
    border-bottom: 1px solid var(--border);
    font-weight: 600;
  }

  .log {
    list-style: none;
    padding: 0;
    margin: 0 0 1.25rem;
  }

  .log li {
    display: grid;
    grid-template-columns: 7.5rem minmax(0, 1fr) auto;
    gap: 0.75rem;
    align-items: baseline;
    margin: 0;
    padding: 0.55rem 0;
  }

  .verb {
    color: var(--accent);
  }

  .what {
    color: var(--text);
    font-family: var(--font-sans);
    font-size: 0.9375rem;
  }

  .state {
    color: var(--tone-vigilia);
  }

  .is-espera .state {
    color: var(--muted);
  }

  .is-espera .state::after {
    content: '';
    display: inline-block;
    width: 0.5em;
    height: 1em;
    margin-left: 0.3em;
    vertical-align: -0.15em;
    background: var(--accent);
  }

  .meter {
    height: 3px;
    border-radius: 2px;
    background: var(--border);
    overflow: hidden;
  }

  .meter span {
    display: block;
    height: 100%;
    width: calc(100% * 5 / 6);
    background: var(--accent);
    transform-origin: left;
  }

  /* Secuencia de carga: la única animación automática de la portada */
  @media (prefers-reduced-motion: no-preference) {
    .hero::after {
      animation: scan 1.4s 0.1s var(--ease-out) both;
    }

    .eyebrow {
      animation: fade 0.6s 0.15s ease-out both;
    }

    .name span {
      animation: wipe 0.9s var(--ease-out) both;
    }

    .name span:first-child {
      animation-delay: 0.25s;
    }

    .name span:last-child {
      animation-delay: 0.4s;
    }

    .bbox {
      animation: lock 0.55s 1s var(--ease-out) both;
    }

    .bbox b {
      animation: fade 0.3s 1.45s ease-out both;
    }

    .lead,
    .lead-sub,
    .actions {
      animation: fade 0.7s 1.1s ease-out both;
    }

    .console {
      animation: fade 0.6s 0.6s ease-out both;
    }

    .log li {
      animation: line 0.35s calc(1.2s + var(--i) * 0.4s) var(--ease-out) both;
    }

    .log .state {
      animation: stamp 0.3s calc(1.45s + var(--i) * 0.4s) var(--ease-out) both;
    }

    .meter span {
      animation: meter 2s 1.2s linear both;
    }

    .is-espera .state::after {
      animation: blink 1s 3.6s steps(2, jump-none) 8;
    }
  }

  @keyframes scan {
    0% {
      top: 0;
      opacity: 0;
    }

    10%,
    85% {
      opacity: 1;
    }

    100% {
      top: 100%;
      opacity: 0;
    }
  }

  @keyframes fade {
    from {
      opacity: 0;
    }
  }

  @keyframes wipe {
    from {
      clip-path: inset(0 100% 0 0);
      transform: translateX(-0.06em);
    }

    to {
      clip-path: inset(0 -10% -20% 0);
    }
  }

  @keyframes lock {
    from {
      opacity: 0;
      transform: scale(1.12);
    }
  }

  @keyframes line {
    from {
      opacity: 0;
      transform: translateX(-0.5rem);
    }
  }

  @keyframes stamp {
    from {
      opacity: 0;
      transform: scale(0.6);
    }
  }

  @keyframes meter {
    from {
      transform: scaleX(0);
    }
  }

  @keyframes blink {
    to {
      opacity: 0;
    }
  }

  /* ---------- Ahora ---------- */
  .now-strip {
    display: grid;
    grid-template-columns: 8rem minmax(0, 1fr);
    align-items: start;
    gap: 2rem;
    padding-block: 1.75rem 4rem;
  }

  .now-strip h2 {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin: 0;
    color: var(--text);
  }

  .pulse {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--tone-vigilia);
  }

  @media (prefers-reduced-motion: no-preference) {
    .pulse {
      animation: pulse 2.4s ease-out infinite;
    }
  }

  @keyframes pulse {
    from {
      box-shadow: 0 0 0 0 color-mix(in srgb, var(--tone-vigilia) 55%, transparent);
    }

    to {
      box-shadow: 0 0 0 9px transparent;
    }
  }

  .now {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 2.5rem;
    margin: 0;
  }

  .now-row dt {
    margin-bottom: 0.35rem;
  }

  .now-row dd {
    margin: 0;
    font-size: 0.9688rem;
    color: var(--text);
  }

  /* ---------- Encabezado de sección partido: título a la izquierda, contexto a la derecha ---------- */
  .split {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    align-items: end;
    gap: 1rem 4rem;
    margin-bottom: 3rem;
  }

  /* Antetítulo y título juntos en la columna izquierda */
  .split > div {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .split p {
    max-width: 34rem;
    margin: 0;
  }

  .split strong {
    color: var(--text);
  }

  /* ---------- Proyectos ---------- */
  .projects {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: 1.25rem;
  }

  .card-item {
    grid-column: span 6;
    margin: 0;
  }

  .card-item:nth-child(1) {
    grid-column: span 7;
  }

  .card-item:nth-child(2) {
    grid-column: span 5;
  }

  .project-card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    height: 100%;
    min-height: 17rem;
    padding: 2rem 2.25rem;
    overflow: hidden;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    text-decoration: none;
    color: var(--text);
    transition: border-color 0.25s ease;
  }

  .is-agentes .project-card {
    min-height: 22rem;
  }

  /* Filo del tono: aparece al seleccionar la tarjeta */
  .project-card::after {
    content: '';
    position: absolute;
    inset: 0 0 auto;
    height: 2px;
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.45s var(--ease-out);
  }

  .project-card:hover,
  .project-card:focus-visible {
    color: var(--text);
    border-color: color-mix(in srgb, var(--accent) 50%, transparent);
  }

  .project-card:hover::after,
  .project-card:focus-visible::after {
    transform: scaleX(1);
  }

  .card-top {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 1rem;
  }

  .kind {
    color: var(--accent);
  }

  .project-name {
    font-size: clamp(1.75rem, 3vw, 2.25rem);
    font-weight: 700;
    font-family: var(--font-display);
