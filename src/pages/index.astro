---
import Base from '../layouts/Base.astro';
import { site } from '../data/site';
import { projects } from '../data/projects';
import { trail, totalCommits, totalPrs, figuresDate } from '../data/trail';
import Icon from '../components/Icon.astro';
import ProjectIcon from '../components/ProjectIcon.astro';
import { getImage } from 'astro:assets';
import grafoPoster from '../assets/images/episteme/grafo-poster.png';

const epistemeThumb = await getImage({ src: grafoPoster, format: 'webp', width: 520 });

const now = [
  {
    label: 'En foco',
    text: 'episteme (v0.23, MIT): servidor MCP de memoria y documentación persistente sobre Markdown y SQLite FTS5, en uso diario.',
  },
  {
    label: 'En uso',
    text: 'fabrik: orquestación guiada por especificaciones con subagentes acotados y verificación por comandos en Claude Code.',
  },
];

const areas = [
  {
    icon: 'terminal' as const,
    title: 'Agentes de IA con método',
    text: 'Flujos con agentes de código (Claude Code, Codex CLI) que parten de una especificación, se verifican con comandos y conservan decisiones entre sesiones, tanto en ingeniería como en procesos de negocio.',
    evidence: [
      { label: 'pulse', href: '/pulse/' },
      { label: 'episteme', href: '/episteme/' },
    ],
  },
  {
    icon: 'code' as const,
    title: 'Software en Python',
    text: 'Mi lenguaje principal: servicios, API, CLI y aplicaciones de escritorio con Pydantic, FastAPI, Typer y PySide6, con pruebas en pytest y análisis estático con Ruff. Uso Rust cuando la latencia es crítica.',
    evidence: [
      { label: 'pulse: 244 pruebas', href: '/pulse/' },
      { label: 'Vigilia Edge: núcleo en Rust', href: '/vigilia-edge/' },
    ],
  },
  {
    icon: 'flow' as const,
    title: 'Automatización e integraciones',
    text: 'Automatizo procesos manuales con integraciones por API y webhooks, CI/CD en GitHub Actions y servicios en AWS y Azure sobre Linux y Docker.',
    evidence: [
      { label: 'Vigilia: eventos ONVIF y MQTT', href: '/vigilia/' },
      { label: 'Este sitio: CI/CD en cada PR', href: 'https://github.com/Bajmein/locus' },
    ],
  },
];

const experience = [
  {
    date: 'oct. 2026 – actualidad',
    role: 'Encargado de TI',
    org: 'Grupo de empresas (remoto)',
    text: 'Responsable del área de tecnología: sitios y plataformas web, datos e integraciones, IA y automatización, soporte y estándares de desarrollo.',
  },
  {
    date: '2021–2025',
    role: 'Ingeniería en Informática',
    org: 'INACAP',
    text: 'Titulado. Proyecto de título: Vigilia Reforged.',
  },
];

const method = [
  {
    title: 'Especificar antes de implementar',
    text: 'Cada cambio parte de una especificación verificable; los agentes ejecutan y los artefactos son la fuente de verdad.',
  },
  {
    title: 'Verificar con comandos',
    text: 'Una tarea está lista cuando una prueba, el lint o la verificación de tipos lo demuestran, no cuando el modelo lo afirma.',
  },
  {
    title: 'La memoria es del usuario',
    text: 'Las decisiones y las lecciones quedan en notas Markdown locales que cualquier agente puede consultar.',
  },
  {
    title: 'Planes autosuficientes',
    text: 'Cada plan lleva sus fuentes, sus decisiones cerradas y su verificación, para que otro agente lo ejecute sin la conversación previa.',
  },
  {
    title: 'Las personas deciden',
    text: 'Los agentes proponen y ejecutan; las decisiones de producto y la fusión de cada cambio quedan en manos de una persona.',
  },
  {
    title: 'La tecnología según el problema',
    text: 'Cada lenguaje y cada herramienta se eligen por lo que exige el problema: latencia, ecosistema y mantenimiento.',
  },
];

const tech = [
  ['Python', 'Pydantic v2, FastAPI, Typer, Hydra, PySide6, OpenCV; pytest, Ruff y uv'],
  ['Otros lenguajes', 'Rust, JavaScript y TypeScript, SQL'],
  ['Web', 'WordPress y su REST API, Astro, HTML y CSS'],
  ['Nube e infraestructura', 'AWS, Azure, Linux, Docker y GitHub Actions'],
  ['Datos', 'SQL (PostgreSQL), SQLite FTS5'],
  ['Integraciones', 'WhatsApp Business API, CRM, formularios y webhooks'],
  ['IA aplicada', 'Claude Code, Codex CLI, Gemini CLI, GitHub Copilot; MCP, hooks, skills y subagentes'],
  ['Visión por computador', 'OpenCV, YOLO, TensorRT, CUDA / NVDEC'],
];

// Ciclo de un cambio (consola del hero): el método de fabrik y episteme, sin cifras inventadas
const cycle = [
  { verb: 'especificar', text: 'Especificación verificable', state: 'ok' },
  { verb: 'planificar', text: 'Fuentes y decisiones cerradas', state: 'ok' },
  { verb: 'implementar', text: 'Subagentes con tareas acotadas', state: 'ok' },
  { verb: 'verificar', text: 'Pruebas, lint y tipos en verde', state: 'ok' },
  { verb: 'recordar', text: 'Decisión guardada en episteme', state: 'ok' },
  { verb: 'fusionar', text: 'Lo decide una persona', state: 'espera' },
];

const kind = { agentes: 'Agentes de IA', vision: 'Visión por computador' } as const;
---

<Base title="Benjamín Criado — ingeniero informático: Python y agentes de IA" description={site.description}>
  <section class="container hero" aria-labelledby="hero-title">
    <div class="hero-main">
      <p class="label eyebrow">Ingeniero informático · Python y agentes de IA · La Serena, Chile</p>
      <div class="target">
        <h1 id="hero-title" class="name"><span>Benjamín</span> <span>Criado</span></h1>
        <span class="bbox" aria-hidden="true">
          <i></i><i></i><i></i><i></i>
          <b class="mono">persona 0,99</b>
        </span>
      </div>
      <p class="lead">
        Construyo software en Python y sistemas con agentes de IA pensados para producción: contratos tipados,
        verificación automatizada y memoria persistente.
      </p>
      <p class="lead-sub">
        Estoy a cargo del área de TI de un grupo de empresas (plataformas web, integraciones y automatización) y
        desarrollo servidores MCP y herramientas propias para trabajar con agentes de código.
      </p>
      <ul class="facts mono" aria-label="Disponibilidad">
        <li>Trabajo remoto</li>
        <li>Inglés avanzado</li>
        <li>Autorización de trabajo en la UE</li>
      </ul>
      <div class="actions">
        <a class="btn btn-primary" href="#proyectos">Ver proyectos</a>
        <a class="btn" href="/cv/">Currículum</a>
      </div>
      <p class="proof mono">
        <span class="proof-stats">
          <span><strong>{totalCommits}</strong> commits</span>
          <span class="sep" aria-hidden="true">·</span>
          <span><strong>{totalPrs}</strong> PR fusionados</span>
        </span>
        <span class="proof-note">
          en tres herramientas propias desde may. 2026 — <a href="#agentes">Ver el recorrido →</a>
        </span>
      </p>
    </div>

    <figure class="console glass" aria-labelledby="ciclo">
      <figcaption id="ciclo">
        <span class="console-head"><span class="console-dot" aria-hidden="true"></span>Ciclo de un cambio</span>
        <span class="mono muted">fabrik + episteme</span>
      </figcaption>
      <ol class="log mono">
        {
          cycle.map((c, i) => (
            <li class={`is-${c.state}`} style={`--i: ${i}`}>
              <span class="verb"><span class="idx">0{i + 1}</span>{c.verb}</span>
              <span class="what">{c.text}</span>
              <span class="state">{c.state}</span>
            </li>
          ))
        }
      </ol>
      <div class="meter" aria-hidden="true"><span></span></div>
    </figure>
  </section>

  <section class="container now-wrap" aria-labelledby="ahora">
    <div class="glass now-strip">
      <h2 id="ahora" class="label"><span class="pulse" aria-hidden="true"></span>Ahora</h2>
      <dl class="now">
        {
          now.map((item) => (
            <div class="now-row">
              <dt class="label">{item.label}</dt>
              <dd>{item.text}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <section class="container section" id="areas" aria-labelledby="areas-title">
    <div class="section-head split">
      <div>
        <p class="label">Qué hago</p>
        <h2 id="areas-title">En qué puedo aportar</h2>
      </div>
      <p class="muted">
        Tres frentes para integrarme a un equipo de ingeniería o ejecutar un proyecto de principio a fin, respaldados
        por software verificable.
      </p>
    </div>
    <ul class="areas-grid">
      {
        areas.map((a, i) => (
          <li class="area-card glass spot reveal">
            <div class="area-top">
              <span class="area-icon"><Icon name={a.icon} /></span>
              <span class="mono area-num">0{i + 1}</span>
            </div>
            <h3>{a.title}</h3>
            <p>{a.text}</p>
            <div class="evidence">
              <span class="label">Evidencia</span>
              <div class="evidence-chips">
                {a.evidence.map((e) => (
                  <a class="mono ev-chip" href={e.href}>
                    {e.label} <span aria-hidden="true">→</span>
                  </a>
                ))}
              </div>
            </div>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="container section" id="proyectos" aria-labelledby="proyectos-title">
    <div class="section-head split">
      <div>
        <p class="label">Proyectos personales</p>
        <h2 id="proyectos-title">Proyectos</h2>
      </div>
      <p class="muted">
        Sistemas que diseñé de principio a fin. Cada página expone el problema, las decisiones de arquitectura y el
        estado del proyecto. El código de episteme es abierto; los otros tres tienen un repositorio vitrina público.
      </p>
    </div>
    <ol class="projects">
      {
        projects.map((p) => (
          <li class:list={['card-item', 'reveal', `is-${p.group}`]}>
            <a class="project-card spot" href={`/${p.slug}/`} style={`--accent: var(--tone-${p.slug})`}>
              <span class="card-top">
                <ProjectIcon slug={p.slug} />
                <span class="label kind">{kind[p.group]}</span>
                {p.badge && <span class="mono card-badge">{p.badge}</span>}
              </span>
              <span class="project-name" style={`view-transition-name: proyecto-${p.slug}`}>
                {p.title}
              </span>
              <span class="label context">{p.card.context ?? p.period}</span>
              <span class="project-text">{p.card.text}</span>
              <span class="mono proof">{p.card.proof}</span>
              <span class="card-foot">
                <span class="chips">
                  {p.card.stack.map((s) => (
                    <span class="mono chip">{s}</span>
                  ))}
                </span>
                <span class="go" aria-hidden="true">
                  Ver proyecto <span class="go-arrow">→</span>
                </span>
              </span>
              {p.slug === 'episteme' ? (
                <img
                  class="card-preview"
                  src={epistemeThumb.src}
                  width={epistemeThumb.attributes.width}
                  height={epistemeThumb.attributes.height}
                  alt=""
                  aria-hidden="true"
                  loading="lazy"
                />
              ) : (
                <span class="mark">
                  <ProjectIcon slug={p.slug} size="xl" />
                </span>
              )}
            </a>
          </li>
        ))
      }
    </ol>
  </section>

  <section class="container section" id="agentes" aria-labelledby="agentes-title">
    <div class="section-head split">
      <div>
        <p class="label">Especialidad</p>
        <h2 id="agentes-title">Cómo trabajo con agentes de IA</h2>
      </div>
      <p class="muted">
        Desde mayo de 2026 desarrollo mis propias herramientas para trabajar con agentes de código; cada una
        resolvió lo que la anterior dejaba pendiente.
      </p>
    </div>
    <div class="trail-wrap">
      <span class="token" aria-hidden="true"></span>
      <ol class="trail">
        {
          trail.map((t) => (
            <li class="step reveal" style={t.slug ? `--accent: var(--tone-${t.slug})` : undefined}>
              <span class="dot" aria-hidden="true" />
              <span class="label">{t.period}</span>
              <h3>{t.href ? <a href={t.href}>{t.name}</a> : t.name}</h3>
              <p>{t.text}</p>
              <span class="mono figures">
                {t.commits} commits, {t.prs} PR
              </span>
              {t.note && <span class="label nopage">{t.note}</span>}
            </li>
          ))
        }
      </ol>
    </div>
    <p class="label source">Cifras de GitHub al {figuresDate}.</p>
    <h3 class="method-title">Método</h3>
    <ul class="method">
      {
        method.map((m) => (
          <li class="reveal">
            <h4>{m.title}</h4>
            <p>{m.text}</p>
          </li>
        ))
      }
    </ul>
  </section>

  <div class="container section two-col">
    <section id="experiencia" aria-labelledby="experiencia-title">
      <div class="section-head">
        <p class="label">Experiencia</p>
        <h2 id="experiencia-title">Trayectoria</h2>
      </div>
      <ol class="timeline">
        {
          experience.map((e) => (
            <li class="tl-row">
              <span class="label tl-date">{e.date}</span>
              <div>
                <h3>{e.role}</h3>
                <p class="org">{e.org}</p>
                {e.text && <p>{e.text}</p>}
              </div>
            </li>
          ))
        }
      </ol>
      <p class="more"><a href="/cv/">Ver currículum completo</a></p>
    </section>

    <section aria-labelledby="tecnologias">
      <div class="section-head">
        <p class="label">Tecnologías</p>
        <h2 id="tecnologias">Con qué trabajo</h2>
      </div>
      <dl class="tech">
        {
          tech.map(([area, items]) => (
            <div>
              <dt class="label">{area}</dt>
              <dd>{items}</dd>
            </div>
          ))
        }
      </dl>
    </section>
  </div>

  <section class="container section contact" id="contacto" aria-labelledby="contacto-title">
    <div class="section-head contact-head">
      <p class="label">Contacto</p>
      <h2 id="contacto-title" class="contact-title">
        Conversemos<span class="cursor" aria-hidden="true">_</span>
      </h2>
    </div>
    <div class="contact-lanes">
      <div class="contact-card glass is-primary">
        <p class="label">Proyectos e integraciones</p>
        <p class="muted">
          Si tienes un proyecto de software en Python, automatización, integraciones o agentes de IA, escríbeme con los
          detalles. Respondo en español y en inglés.
        </p>
        <a class="mail" href={`mailto:${site.email}`}><Icon name="mail" />{site.email}</a>
        <div class="contact-actions">
          <button type="button" class="btn copy" data-copy={site.email} hidden>Copiar correo</button>
          <span class="label copy-status" role="status" aria-live="polite"></span>
        </div>
      </div>
      <div class="contact-card glass">
        <p class="label">Equipos y contratación</p>
        <p class="muted">
          Si buscas incorporar a alguien a tu equipo, en el currículum encontrarás mi experiencia completa, stack
          detallado, formación e idiomas.
        </p>
        <div class="contact-actions">
          <a class="btn btn-primary" href="/cv/">Ver currículum</a>
          <a class="btn" href="/assets/pdf/cv_benjamin_criado.pdf" download>Descargar CV (PDF)</a>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  /* ---------- Hero: el nombre como objeto detectado ---------- */
  .hero {
    position: relative;
    isolation: isolate;
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(0, 0.95fr);
    gap: clamp(2rem, 5vw, 5rem);
    align-items: start;
    padding-block: clamp(3.5rem, 7vw, 5.5rem) clamp(3rem, 6vw, 4.5rem);
  }

  /* Línea de barrido: recorre el hero una vez al cargar, como un sensor */
  .hero::after {
    content: '';
    position: absolute;
    left: var(--gutter);
    right: var(--gutter);
    top: 0;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--accent) 30%, var(--accent) 70%, transparent);
    box-shadow: 0 0 18px 2px color-mix(in srgb, var(--accent) 45%, transparent);
    opacity: 0;
    pointer-events: none;
  }

  /* Grilla fina de sensor, solo en el hero y desvanecida hacia la lámpara */
  .hero::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    background-image:
      linear-gradient(var(--grid-line) 1px, transparent 1px),
      linear-gradient(90deg, var(--grid-line) 1px, transparent 1px);
    background-size: 56px 56px;
    -webkit-mask-image: radial-gradient(ellipse 80% 70% at 75% 20%, #000, transparent 75%);
    mask-image: radial-gradient(ellipse 80% 70% at 75% 20%, #000, transparent 75%);
  }

  .eyebrow {
    margin-bottom: 3.5rem;
    text-wrap: balance;
    font-weight: 500;
    color: var(--muted);
  }

  .target {
    margin-bottom: 2.25rem;
  }

  .name {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(3.5rem, 7.6vw, 7rem);
    font-weight: 800;
    font-stretch: 112%;
    letter-spacing: -0.035em;
    line-height: 0.92;
  }

  .name span {
    display: block;
  }

  .lead {
    max-width: 34rem;
    font-size: clamp(1.25rem, 2vw, 1.5rem);
    font-weight: 500;
    line-height: 1.4;
    color: var(--text);
    margin-bottom: 0.9rem;
  }

  .lead-sub {
    max-width: 36rem;
    color: var(--muted);
    margin-bottom: 2.25rem;
  }

  /* Disponibilidad: pastillas sutiles bajo el texto */
  .lead-sub:has(+ .facts) {
    margin-bottom: 1.15rem;
  }

  .facts {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    list-style: none;
    padding: 0;
    margin: 0 0 2rem;
    font-size: 0.8125rem;
    color: var(--text);
  }

  .facts li {
    margin: 0;
    padding: 0.25rem 0.65rem;
    border-radius: 999px;
    border: 1px solid var(--glass-border);
    background: color-mix(in srgb, var(--surface) 70%, transparent);
  }

  /* Prueba bajo los botones: métricas destacadas que respaldan la especialidad */
  .hero .proof {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.35rem 0.6rem;
    max-width: 38rem;
    margin: 1.5rem 0 0;
    padding-top: 1.15rem;
    border-top: 1px solid color-mix(in srgb, var(--border) 70%, transparent);
    font-size: 0.8125rem;
    color: var(--muted);
  }

  .proof-stats {
    display: inline-flex;
    align-items: baseline;
    gap: 0.45rem;
    color: var(--text);
  }

  .proof-stats .sep {
    color: var(--accent);
  }

  .hero .proof strong {
    color: var(--accent);
    font-size: 0.9375rem;
    font-weight: 600;
  }

  .hero .proof a {
    color: var(--accent);
    text-decoration-color: color-mix(in srgb, var(--accent) 40%, transparent);
  }

  /* Consola: el método como un registro que avanza */
  .console {
    margin: 0;
    padding: 1.4rem 1.65rem 1.65rem;
  }

  .console figcaption {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    padding-bottom: 0.95rem;
    margin-bottom: 0.35rem;
    border-bottom: 1px solid var(--border);
    font-weight: 600;
  }

  .console-head {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
  }

  .console-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--accent) 20%, transparent);
  }

  .console figcaption .mono {
    white-space: nowrap;
  }

  .log {
    list-style: none;
    padding: 0;
    margin: 0 0 1.15rem;
  }

  .log li {
    display: grid;
    grid-template-columns: 8.75rem minmax(0, 1fr) auto;
    gap: 0.75rem;
    align-items: baseline;
    margin: 0;
    padding: 0.55rem 0;
  }

  .log li + li {
    border-top: 1px solid color-mix(in srgb, var(--border) 45%, transparent);
  }

  .verb {
    color: var(--accent);
  }

  .verb .idx {
    color: var(--muted);
    margin-right: 0.45rem;
    font-size: 0.75rem;
  }

  .what {
    color: var(--text);
    font-family: var(--font-sans);
    font-size: 0.9375rem;
  }

  .state {
    color: var(--tone-vigilia);
  }

  .is-espera .state {
    color: var(--muted);
  }

  .is-espera .state::after {
    content: '';
    display: inline-block;
    width: 0.5em;
    height: 1em;
    margin-left: 0.3em;
    vertical-align: -0.15em;
    background: var(--accent);
  }

  .meter {
    height: 3px;
    border-radius: 2px;
    background: var(--border);
    overflow: hidden;
  }

  .meter span {
    display: block;
    height: 100%;
    width: calc(100% * 5 / 6);
    background: var(--accent);
    transform-origin: left;
  }

  /* Secuencia de carga: la única animación automática de la portada */
  @media (prefers-reduced-motion: no-preference) {
    .hero::after {
      animation: scan 1.4s 0.1s var(--ease-out) both;
    }

    .eyebrow {
      animation: fade 0.6s 0.15s ease-out both;
    }

    .name span {
      animation: wipe 0.9s var(--ease-out) both;
    }

    .name span:first-child {
      animation-delay: 0.25s;
    }

    .name span:last-child {
      animation-delay: 0.4s;
    }

    .lead,
    .lead-sub,
    .facts,
    .actions,
    .hero .proof {
      animation: fade 0.7s 1.1s ease-out both;
    }

    .console {
      animation: fade 0.6s 0.6s ease-out both;
    }

    .log li {
      animation: line 0.35s calc(1.2s + var(--i) * 0.4s) var(--ease-out) both;
    }

    .log .state {
      animation: stamp 0.3s calc(1.45s + var(--i) * 0.4s) var(--ease-out) both;
    }

    .meter span {
      animation: meter 2s 1.2s linear both;
    }

    .is-espera .state::after {
      animation: blink 1s 3.6s steps(2, jump-none) 8;
    }
  }

  @keyframes scan {
    0% {
      top: 0;
      opacity: 0;
    }

    10%,
    85% {
      opacity: 1;
    }

    100% {
      top: 100%;
      opacity: 0;
    }
  }

  @keyframes wipe {
    from {
      clip-path: inset(0 100% 0 0);
      transform: translateX(-0.06em);
    }

    to {
      clip-path: inset(0 -10% -20% 0);
    }
  }

  @keyframes line {
    from {
      opacity: 0;
      transform: translateX(-0.5rem);
    }
  }

  @keyframes stamp {
    from {
      opacity: 0;
      transform: scale(0.6);
    }
  }

  @keyframes meter {
    from {
      transform: scaleX(0);
    }
  }

  @keyframes blink {
    to {
      opacity: 0;
    }
  }

  /* ---------- Ahora ---------- */
  .now-wrap {
    padding-block: 0.5rem 3.5rem;
  }

  .now-strip {
    display: grid;
    grid-template-columns: 7rem minmax(0, 1fr);
    align-items: center;
    gap: 1.75rem;
    padding: 1.25rem 1.75rem;
  }

  .now-strip h2 {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin: 0;
    color: var(--text);
  }

  .pulse {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--tone-vigilia);
  }

  @media (prefers-reduced-motion: no-preference) {
    .pulse {
      animation: pulse 2.4s ease-out infinite;
    }
  }

  @keyframes pulse {
    from {
      box-shadow: 0 0 0 0 color-mix(in srgb, var(--tone-vigilia) 55%, transparent);
    }

    to {
      box-shadow: 0 0 0 9px transparent;
    }
  }

  .now {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 2rem;
    margin: 0;
  }

  .now-row + .now-row {
    padding-left: 2rem;
    border-left: 1px solid var(--glass-border);
  }

  .now-row dt {
    margin-bottom: 0.3rem;
    color: var(--accent);
  }

  .now-row dd {
    margin: 0;
    font-size: 0.9688rem;
    color: var(--text);
  }

  /* ---------- Encabezado de sección partido: título a la izquierda, contexto a la derecha ---------- */
  .split {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    align-items: end;
    gap: 1rem 4rem;
    margin-bottom: 3rem;
  }

  /* Antetítulo y título juntos en la columna izquierda */
  .split > div {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .split p {
    max-width: 34rem;
    margin: 0;
  }

  .split strong {
    color: var(--text);
  }

  /* ---------- Qué hago (#areas) ---------- */
  .areas-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.25rem;
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .area-card {
    display: flex;
    flex-direction: column;
    padding: 1.75rem;
    margin: 0;
    transition:
      border-color 0.25s ease,
      transform 0.3s var(--ease-out);
  }

  .area-card:hover {
    border-color: color-mix(in srgb, var(--accent) 45%, transparent);
    transform: translateY(-2px);
  }

  @media (prefers-reduced-motion: reduce) {
    .area-card:hover {
      transform: none;
    }
  }

  .area-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 1.25rem;
  }

  .area-icon {
    display: inline-grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: var(--radius);
    background: color-mix(in srgb, var(--accent) 12%, transparent);
    border: 1px solid color-mix(in srgb, var(--accent) 30%, transparent);
    color: var(--accent);
    font-size: 1.25rem;
  }

  .area-num {
    color: var(--muted);
    font-size: 0.8125rem;
  }

  .area-card h3 {
    font-family: var(--font-display);
    font-stretch: 112%;
    font-size: 1.25rem;
    font-weight: 700;
    margin-bottom: 0.6rem;
  }

  .area-card p {
    color: var(--muted);
    font-size: 0.9688rem;
    margin-bottom: 1.5rem;
  }

  .area-card .evidence {
    margin-top: auto;
    padding-top: 1rem;
    border-top: 1px solid var(--glass-border);
  }

  .area-card .evidence .label {
    display: block;
    font-size: 0.75rem;
    margin-bottom: 0.5rem;
  }

  .evidence-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .ev-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    padding: 0.2rem 0.6rem;
    border-radius: 999px;
    border: 1px solid color-mix(in srgb, var(--accent) 30%, var(--border));
    background: color-mix(in srgb, var(--accent) 8%, transparent);
    color: var(--text);
    font-size: 0.8125rem;
    text-decoration: none;
    transition: border-color 0.15s ease, color 0.15s ease, background-color 0.15s ease;
  }

  .ev-chip:hover {
    border-color: var(--accent);
    background: color-mix(in srgb, var(--accent) 16%, transparent);
    color: var(--accent);
  }

  /* ---------- Proyectos ---------- */
  .projects {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: 1.25rem;
  }

  .card-item {
    grid-column: span 6;
    margin: 0;
  }

  .card-item:nth-child(1) {
    grid-column: span 7;
  }

  .card-item:nth-child(2) {
    grid-column: span 5;
  }

  .project-card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    height: 100%;
    min-height: 17.5rem;
    padding: 2rem 2.25rem;
    overflow: hidden;
    background:
      radial-gradient(24rem circle at 92% 96%, color-mix(in srgb, var(--accent) 9%, transparent), transparent 68%),
      var(--surface);
    border: 1px solid var(--border);
    border-top-color: color-mix(in srgb, var(--accent) 32%, var(--border));
    border-radius: var(--radius-lg);
    text-decoration: none;
    color: var(--text);
    transition:
      transform 0.3s var(--ease-out),
      border-color 0.25s ease;
  }

  .is-agentes .project-card {
    min-height: 22rem;
  }

  /* Filo del tono: aparece al seleccionar la tarjeta */
  .project-card::after {
    content: '';
    position: absolute;
    inset: 0 0 auto;
    height: 2px;
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.45s var(--ease-out);
  }

  .project-card:hover,
  .project-card:focus-visible {
    color: var(--text);
    border-color: color-mix(in srgb, var(--accent) 50%, transparent);
    transform: translateY(-3px);
  }

  @media (prefers-reduced-motion: reduce) {
    .project-card:hover,
    .project-card:focus-visible {
      transform: none;
    }
  }

  .project-card:hover::after,
  .project-card:focus-visible::after {
    transform: scaleX(1);
  }

  .card-top {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1rem;
    margin-bottom: 0.85rem;
  }

  .kind {
    color: var(--accent);
  }

  .card-badge {
    margin-left: auto;
    padding: 0.2rem 0.6rem;
    border-radius: 999px;
    border: 1px solid color-mix(in srgb, var(--accent) 38%, transparent);
    background: color-mix(in srgb, var(--accent) 12%, transparent);
    color: var(--accent);
    font-size: 0.75rem;
    font-weight: 500;
  }

  .project-name {
    font-size: clamp(1.75rem, 3vw, 2.25rem);
    font-weight: 700;
    font-family: var(--font-display);
    font-stretch: 112%;
    letter-spacing: -0.02em;
    line-height: 1.1;
  }

  .is-agentes .project-name {
    font-size: clamp(2rem, 3.6vw, 2.75rem);
  }

  .context {
    margin-top: -0.25rem;
  }

  .project-text {
    max-width: 30rem;
    color: var(--muted);
  }

  .project-card .proof {
    font-size: 0.8125rem;
    color: var(--accent);
  }

  .card-foot {
    position: relative;
    z-index: 1;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem 1rem;
    margin-top: auto;
    padding-top: 1.1rem;
    border-top: 1px solid color-mix(in srgb, var(--border) 65%, transparent);
  }

  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .chip {
    padding: 0.2rem 0.6rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    font-size: 0.8125rem;
    color: var(--muted);
    background: color-mix(in srgb, var(--bg) 45%, transparent);
  }

  .go {
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--accent);
    white-space: nowrap;
  }

  .go-arrow {
    display: inline-block;
    transition: transform 0.2s ease;
  }

  .project-card:hover .go-arrow,
  .project-card:focus-visible .go-arrow {
    transform: translateX(0.25rem);
  }

  @media (prefers-reduced-motion: reduce) {
    .project-card:hover .go-arrow,
    .project-card:focus-visible .go-arrow {
      transform: none;
    }
  }

  /* Vista previa atmosférica del grafo en la tarjeta principal de episteme */
  .card-preview {
    position: absolute;
    right: -1.5rem;
    top: 2.75rem;
    width: 17.5rem;
    height: auto;
    opacity: 0.34;
    pointer-events: none;
    border-radius: var(--radius);
    -webkit-mask-image: radial-gradient(circle at 68% 48%, #000 18%, transparent 74%);
    mask-image: radial-gradient(circle at 68% 48%, #000 18%, transparent 74%);
    transition:
      opacity 0.4s ease,
      transform 0.45s var(--ease-out);
  }

  .project-card:hover .card-preview,
  .project-card:focus-visible .card-preview {
    opacity: 0.55;
    transform: scale(1.03);
  }

  @media (prefers-reduced-motion: reduce) {
    .project-card:hover .card-preview,
    .project-card:focus-visible .card-preview {
      transform: none;
    }
  }

  /* Marca de agua: el ícono del proyecto en grande, en la esquina y tenue para no tapar el texto */
  .mark {
    position: absolute;
    right: -2rem;
    bottom: -2rem;
    width: 12rem;
    height: 12rem;
    color: var(--accent);
    opacity: 0.06;
    transition: opacity 0.4s ease;
    pointer-events: none;
  }

  .is-agentes .mark {
    width: 15rem;
    height: 15rem;
  }

  .mark :global(.project-icon) {
    width: 100%;
    height: 100%;
  }

  .project-card:hover .mark,
  .project-card:focus-visible .mark {
    opacity: 0.14;
  }

  /* El texto deja libre la esquina de la marca de agua */
  @media (min-width: 761px) {
    .project-text {
      max-width: min(30rem, 72%);
    }
  }

  /* ---------- Trabajo con agentes ---------- */
  .trail-wrap {
    position: relative;
  }

  .trail {
    position: relative;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0 2rem;
    list-style: none;
    padding: 0;
    margin: 0 0 1.5rem;
  }

  /* Riel y su relleno, a la altura del centro de los puntos */
  .trail::before,
  .trail::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    top: 0.5rem;
    height: 1px;
    background: var(--border);
  }

  .trail::after {
    background: var(--accent);
    transform-origin: left;
  }

  /* Ficha que viaja por el riel: caja de ancho 0 que avanza con left (un translateX(100%) sobre una caja del
     ancho del riel la dejaba fuera de la página y creaba scroll horizontal) */
  .token {
    position: absolute;
    top: 0.5rem;
    left: 0;
    z-index: 2;
    width: 0;
    height: 0;
    pointer-events: none;
    display: none;
  }

  .token::after {
    content: '';
    position: absolute;
    left: -0.4rem;
    top: -0.4rem;
    width: 0.8rem;
    height: 0.8rem;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 0 5px color-mix(in srgb, var(--accent) 22%, transparent);
  }

  /* Subgrid: período, nombre, texto, cifras y nota quedan alineados entre los pasos */
  .step {
    position: relative;
    margin: 0;
    padding-top: 2.25rem;
    display: grid;
    grid-row: span 5;
    grid-template-rows: subgrid;
    align-content: start;
  }

  .dot {
    position: absolute;
    top: 0;
    left: 0;
    z-index: 1;
    width: 1rem;
    height: 1rem;
    border-radius: 50%;
    background: var(--accent);
    border: 3px solid var(--bg);
    transition: transform 0.2s ease;
  }

  .step:not([style]) .dot {
    background: var(--bg);
    border: 2px solid var(--muted);
  }

  .step:hover .dot {
    transform: scale(1.25);
  }

  .step h3 {
    margin: 0.3rem 0 0.5rem;
    font-size: 1.5rem;
    font-family: var(--font-display);
    font-stretch: 112%;
    font-weight: 700;
  }

  .step h3 a {
    color: var(--accent);
    text-decoration-color: color-mix(in srgb, var(--accent) 40%, transparent);
  }

  .step p {
    color: var(--muted);
    font-size: 0.9688rem;
    margin-bottom: 1rem;
  }

  .figures {
    color: var(--text);
  }

  .nopage {
    margin-top: 0.35rem;
    font-size: 0.8125rem;
  }

  .source {
    margin-bottom: 4rem;
    font-size: 0.8125rem;
  }

  @keyframes fill-y {
    from {
      transform: scaleY(0);
    }
  }

  /*
   * Escritorio: el riel es una línea de 1 px y solo se ve durante unos 800 px de scroll, así que ligado al
   * scroll se llenaba demasiado rápido. Avanza con duración propia cuando entra en pantalla: el script del
   * final pone .is-armed (riel vacío, sin transición) y luego .is-in. Sin JS o con movimiento reducido
   * queda lleno.
   */
  @media (prefers-reduced-motion: no-preference) and (min-width: 761px) {
    .trail-wrap.is-armed .trail::after {
      transform: scaleX(0);
    }

    .trail-wrap.is-armed .token {
      display: block;
    }

    .trail-wrap.is-armed.is-in .trail::after {
      transform: scaleX(1);
      transition: transform 2.8s cubic-bezier(0.45, 0, 0.25, 1);
    }

    .trail-wrap.is-armed.is-in .token {
      left: 100%;
      transition: left 2.8s cubic-bezier(0.45, 0, 0.25, 1);
    }
  }

  /* Móvil: el relleno vertical baja con el scroll, a la altura del centro de la pantalla */
  @media (prefers-reduced-motion: no-preference) and (max-width: 760px) {
    @supports (animation-timeline: view()) {
      .trail::after {
        animation: fill-y linear both;
      }

      /* Regla aparte: el minificador funde animation-timeline en el atajo animation y lo invalida */
      [class~='trail']::after {
        animation-timeline: view();
        animation-range: cover 22% cover 78%;
      }
    }
  }

  .method-title {
    margin-bottom: 1.25rem;
    font-size: 1.5rem;
    font-family: var(--font-display);
    font-stretch: 112%;
    font-weight: 700;
  }

  .method {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .method li {
    margin: 0;
    padding: 1.5rem 2rem 0.75rem 0;
    border-top: 1px solid var(--border);
  }

  .method li:not(:nth-child(3n + 1)) {
    padding-left: 2rem;
    border-left: 1px solid var(--border);
  }

  .method h3,
  .method h4 {
    margin-bottom: 0.5rem;
    font-size: 1.0625rem;
  }

  .method p {
    color: var(--muted);
    font-size: 0.9688rem;
  }

  /* Evidencia de cada área: enlaces a lo que lo demuestra */
  .method .evidence {
    margin-top: 0.75rem;
    font-size: 0.8125rem;
  }

  .method .evidence .label {
    margin-right: 0.5rem;
  }

  .method .evidence a {
    color: var(--accent);
    text-decoration-color: color-mix(in srgb, var(--accent) 40%, transparent);
  }

  /* ---------- Trayectoria y tecnologías, lado a lado ---------- */
  .two-col {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 4rem;
  }

  .two-col .section-head h2 {
    font-size: clamp(1.75rem, 3vw, 2.25rem);
  }

  .timeline {
    list-style: none;
    padding: 0;
    margin: 0 0 2rem;
  }

  .tl-row {
    display: grid;
    grid-template-columns: 7.5rem minmax(0, 1fr);
    gap: 0 1.5rem;
    margin: 0;
  }

  .tl-row > div {
    position: relative;
    padding: 0 0 2rem 1.75rem;
    border-left: 1px solid var(--border);
  }

  .tl-row:last-child > div {
    padding-bottom: 0.25rem;
  }

  .tl-row > div::before {
    content: '';
    position: absolute;
    left: -4px;
    top: 0.55rem;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--border);
  }

  .tl-row:first-child > div::before {
    background: var(--accent);
  }

  .tl-date {
    padding-top: 0.1rem;
  }

  .tl-row h3 {
    margin: 0;
    font-size: 1.0625rem;
  }

  .tl-row .org {
    margin: 0;
    color: var(--muted);
  }

  .tl-row p:not(.org) {
    margin: 0.4rem 0 0;
    color: var(--muted);
    font-size: 0.9688rem;
  }

  .more a {
    font-weight: 600;
    color: var(--accent);
    text-decoration-color: color-mix(in srgb, var(--accent) 35%, transparent);
  }

  .tech {
    margin: 0;
    border-top: 1px solid var(--border);
  }

  .tech div {
    display: grid;
    grid-template-columns: 11rem minmax(0, 1fr);
    gap: 1.5rem;
    padding-block: 0.9rem;
    border-bottom: 1px solid var(--border);
  }

  .tech dd {
    margin: 0;
    font-size: 0.9688rem;
  }

  /* ---------- Contacto: cierra con el mismo tipo que abre ---------- */
  .contact-head {
    margin-bottom: 2.5rem;
  }

  .contact-title {
    margin: 0;
    font-size: clamp(3rem, 8vw, 7rem);
    font-weight: 800;
    font-family: var(--font-display);
    font-stretch: 112%;
    letter-spacing: -0.035em;
    line-height: 0.95;
  }

  /* Cierra con el cursor del logo (bc_) en vez de la barra de sección */
  .contact-title::after {
    display: none;
  }

  .contact-title .cursor {
    color: var(--accent);
  }

  /* Entra con el mismo barrido del nombre, ligado al scroll */
  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: view()) {
      .contact-title {
        animation: wipe linear both;
      }

      /* Regla aparte: el minificador funde animation-timeline en el atajo animation y lo invalida */
      [class~='contact-title'] {
        animation-timeline: view();
        animation-range: entry 10% cover 35%;
      }
    }
  }

  .contact-lanes {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
    gap: 1.25rem;
  }

  .contact-card {
    display: flex;
