---
import Base from '../layouts/Base.astro';
---

<Base
  noindex
  title="Página no encontrada — Benjamín Criado"
  description="La página que buscas no existe o cambió de dirección. Vuelve al inicio para ver los proyectos y el currículum de Benjamín Criado."
>
  <section class="container notfound">
    <div class="glass notfound-panel">
      <p class="label">Error 404</p>
      <div class="target">
        <h1>Esta página no existe.</h1>
        <span class="bbox is-miss" aria-hidden="true">
          <i></i><i></i><i></i><i></i>
          <b class="mono">sin detección</b>
        </span>
      </div>
      <p class="muted">Puede que la dirección haya cambiado. Los proyectos y el currículum están en el inicio.</p>
      <a class="btn btn-primary" href="/">Volver al inicio</a>
    </div>
  </section>
</Base>

<style>
  .notfound {
    padding-block: clamp(5rem, 15vw, 9rem);
  }

  .notfound-panel {
    padding: clamp(1.5rem, 5vw, 3rem);
    max-width: 40rem;
  }

  .notfound .label {
    color: var(--accent);
    margin-bottom: 2.75rem;
  }

  /* Margen para la caja, que sobresale 1,25rem a cada lado del título */
  .notfound .target {
    margin: 0 1.25rem 2.25rem;
  }

  .notfound h1 {
    margin: 0;
  }

  .notfound .bbox {
    animation-delay: 0.3s;
  }

  .notfound .bbox b {
    animation-delay: 0.75s;
  }

  .notfound .muted {
    margin-bottom: 2rem;
  }
</style>
