---
import Base from '../layouts/Base.astro';
import { site, cv } from '../data/site';

const pdf = '/assets/pdf/cv_benjamin_criado.pdf';

const projects = [
  {
    name: 'episteme',
    period: 'oct. 2026 – actualidad',
    meta: 'Memoria persistente para agentes de IA · Python, MCP, SQLite FTS5',
    href: '/episteme/',
    source: 'https://github.com/Bajmein/episteme',
    items: [
      'Servidor MCP local que guarda decisiones, lecciones y documentación de proyectos en un vault Markdown compatible con Obsidian.',
      'Búsqueda de texto completo en español con SQLite FTS5 y avisos de normas antes de editar cada archivo.',
      'Detecta duplicados y enlaces rotos y rechaza credenciales. En uso diario (v0.13): 336 commits y 121 pull requests fusionados.',
    ],
  },
  {
    name: 'pulse',
    period: 'may.–jul. 2026',
    meta: 'Motor de desarrollo guiado por especificaciones (SDD) · Python, FastMCP, Pydantic',
    href: '/pulse/',
    items: [
      'Máquina de estados de ocho fases con compuertas declarativas y aprobación humana del diseño antes de implementar.',
      'Arquitectura hexagonal con contratos en Pydantic v2; un servidor MCP para Claude Code, Codex CLI y otros agentes.',
      'Revisión automática al cerrar (ruff, bandit, pytest y ty) y 244 tests, incluidas pruebas basadas en propiedades.',
    ],
  },
  {
    name: 'Vigilia Reforged',
    period: '2025',
    meta: 'Proyecto de título · Visión por computador en tiempo real · Rust y Python',
    href: '/vigilia/',
    items: [
      'Decodificación de video en la GPU con un módulo en Rust (NVDEC), sin pasar los cuadros por la CPU, para tiempos de respuesta críticos en equipos locales.',
      'Monitoreo autónomo sin dependencia de la nube: zonas de seguridad configurables, alertas multicanal e integración con sistemas VMS (ONVIF Profile M, MQTT).',
      'Comunicación sin copias entre el núcleo en Rust y la orquestación en Python mediante memoria compartida (Iceoryx2).',
    ],
  },
  {
    name: 'Vigilia Edge',
    period: '2025',
    meta: 'Primera generación de Vigilia · Visión por computador en escritorio · Python, Rust, TensorRT',
    href: '/vigilia-edge/',
    items: [
      'Detección y seguimiento de objetos en tiempo real en un PC de escritorio, sin nube, con YOLO sobre TensorRT y ONNX Runtime en GPU.',
      'Procesos separados, memoria compartida y un núcleo en Rust (PyO3) que evitan el cuello de botella del GIL: menos de dos cuadros (≈ 80 ms) de la cámara a la pantalla.',
    ],
  },
];

const stack = [
  ['Python', 'Lenguaje principal: Pydantic v2, FastAPI, Typer, Hydra, PySide6, OpenCV; pytest, Ruff y uv.'],
  ['Otros lenguajes', 'Rust (sistemas de tiempo real), JavaScript y TypeScript, SQL (PostgreSQL y SQLite).'],
  ['Web e integraciones', 'WordPress y su REST API, Astro, HTML y CSS; WhatsApp Business API, CRM, formularios y webhooks.'],
  ['Nube e infraestructura', 'AWS, Azure, Linux (Fedora), Docker y CI/CD con GitHub Actions.'],
  ['IA aplicada', 'Claude Code, Codex CLI, Gemini CLI y GitHub Copilot; Model Context Protocol (MCP), hooks, skills, subagentes e ingeniería de contexto.'],
  ['Visión por computador', 'OpenCV, YOLO, TensorRT, ONNX Runtime, CUDA y NVDEC.'],
  ['Arquitectura y calidad', 'Desarrollo guiado por especificaciones (SDD), por pruebas (TDD) y por el dominio (DDD); arquitectura hexagonal.'],
];
---

<Base title={cv.title} description={cv.description}>
  <article class="container cv">
    <header class="cv-head">
      <div>
        <p class="label">Currículum</p>
        <h1>{site.fullName}</h1>
        <p class="role">Ingeniero informático · Python y agentes de IA</p>
        <ul class="contact">
          <li>{site.location}</li>
          <li><a href={`mailto:${site.email}`}>{site.email}</a></li>
          <li><a href={site.github}>github.com/Bajmein</a></li>
          <li><a href={site.linkedin}>linkedin.com/in/benjamin-criado-rossa</a></li>
        </ul>
      </div>
      <a class="btn btn-primary no-print" href={pdf} download>Descargar PDF</a>
    </header>

    <section class="cv-section">
      <h2 class="label">Perfil</h2>
      <div>
        <p>
          Ingeniero informático especializado en Python y agentes de IA. Desde abril de 2026 he desarrollado cuatro
          herramientas propias para trabajar con agentes de código (Forge, pulse, fabrik y episteme), con 982 commits y
          255 pull requests fusionados en total. Actualmente soy responsable del área de TI de un grupo de empresas:
          sitios y plataformas web, integraciones por API, nube y automatización. Elijo la tecnología según el
          problema: Rust para la latencia crítica y Python para la orquestación. Tres años de residencia y trabajo en
          el extranjero avalan mi autonomía y mi inglés avanzado.
        </p>
      </div>
    </section>

    <section class="cv-section">
      <h2 class="label">Experiencia</h2>
      <div>
        <div class="entry">
          <div class="entry-head">
            <h3>Encargado de TI <span class="muted">· Grupo de empresas, remoto</span></h3>
            <span class="label">oct. 2026 – actualidad</span>
          </div>
          <p>Responsable del área de tecnología.</p>
          <ul>
            <li>
              Desarrollo y mantenimiento de los sitios y plataformas web corporativos: dominios, alojamiento,
              certificados, rendimiento y seguridad.
            </li>
            <li>Bases de datos e integraciones por API entre sitios y sistemas.</li>
            <li>Implementación de agentes de IA y automatización de procesos.</li>
            <li>Soporte técnico, estándares de desarrollo y documentación.</li>
          </ul>
        </div>
        <div class="entry">
          <div class="entry-head">
            <h3>Práctica profesional <span class="muted">· Desarrollo web y automatización</span></h3>
            <span class="label">jul.–sep. 2026</span>
          </div>
        </div>
      </div>
    </section>

    <section class="cv-section">
      <h2 class="label">Proyectos</h2>
      <div>
        {
          projects.map((p) => (
            <div class="entry">
              <div class="entry-head">
                <h3><a href={p.href}>{p.name}</a></h3>
                <span class="label">{p.period}</span>
              </div>
              <p class="muted meta">
                {p.meta}
                {p.source && (
                  <>
                    {' · Código abierto: '}
                    <a href={p.source}>{p.source.replace('https://', '')}</a>
                  </>
                )}
              </p>
              <ul>
                {p.items.map((i) => <li>{i}</li>)}
              </ul>
            </div>
          ))
        }
      </div>
    </section>

    <section class="cv-section">
      <h2 class="label">Stack técnico</h2>
      <dl class="stack">
        {
          stack.map(([k, v]) => (
            <div>
              <dt>{k}</dt>
              <dd>{v}</dd>
            </div>
          ))
        }
      </dl>
    </section>

    <section class="cv-section">
      <h2 class="label">Formación</h2>
      <div>
        <div class="entry">
          <div class="entry-head">
            <h3>Ingeniería en Informática <span class="muted">· INACAP</span></h3>
            <span class="label">2021–2025</span>
          </div>
          <ul>
            <li>Titulado. Proyecto de título: Vigilia Reforged.</li>
            <li>Destacado en proyectos de innovación y emprendimiento, y en la feria Go Innova.</li>
            <li>Destacado en programación y computación en la nube (AWS).</li>
            <li>Certificación PCEP – Certified Entry-Level Python Programmer (Python Institute, 2023).</li>
          </ul>
        </div>
      </div>
    </section>

    <section class="cv-section">
      <h2 class="label">Experiencia internacional</h2>
      <div>
        <div class="entry">
          <div class="entry-head">
            <h3>Residencia y trabajo en el extranjero</h3>
            <span class="label">2016–2019</span>
          </div>
          <ul>
            <li>Nueva Zelanda y Australia (visas Working Holiday).</li>
            <li>Estancias en Singapur y Malasia.</li>
            <li>Residencia en Europa: Alemania, Italia, Finlandia y Estonia.</li>
            <li>Ciudadanía italiana: autorización de trabajo en la Unión Europea.</li>
          </ul>
        </div>
      </div>
    </section>

    <section class="cv-section">
      <h2 class="label">Idiomas</h2>
      <dl class="stack">
        <div><dt>Español</dt><dd>Nativo</dd></div>
        <div><dt>Inglés</dt><dd>Avanzado</dd></div>
      </dl>
    </section>
  </article>
</Base>

<style>
  .cv {
    max-width: calc(52rem + 2 * var(--gutter));
    padding-block: 3rem 4.5rem;
  }

  .cv-head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1.5rem;
    padding-bottom: 2rem;
    margin-bottom: 0.5rem;
  }

  .cv-head .label {
    margin-bottom: 0.75rem;
  }

  .cv-head h1 {
    font-size: clamp(1.875rem, 4.5vw, 2.5rem);
    margin-bottom: 0.4rem;
  }

  .role {
    color: var(--muted);
    margin-bottom: 1rem;
  }

  .contact {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.25rem;
    list-style: none;
    padding: 0;
    margin: 0;
    font-size: 0.9375rem;
    color: var(--muted);
  }

  .contact li {
    margin: 0;
  }

  .contact a {
    color: var(--muted);
  }

  .contact a:hover {
    color: var(--accent);
  }

  .cv-section {
    display: grid;
    grid-template-columns: 11rem minmax(0, 1fr);
    gap: 0.75rem 2rem;
    padding-block: 1.75rem;
    border-top: 1px solid var(--border);
  }

  .cv-section > h2 {
    margin: 0;
    padding-top: 0.2rem;
    color: var(--accent);
  }

  .entry + .entry {
    margin-top: 1.5rem;
  }

  .entry-head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: 0.25rem 1rem;
  }

  .entry h3 {
    margin: 0;
    font-size: 1.0625rem;
  }

  .entry h3 .muted {
    font-weight: 400;
  }

  .entry h3 a {
    text-decoration: none;
  }

  .entry p {
    margin: 0.4rem 0 0.5rem;
  }

  .entry .meta {
    font-size: 0.9375rem;
  }

  .entry ul {
    margin: 0.5rem 0 0;
    color: var(--text);
  }

  .entry li {
    font-size: 0.9688rem;
  }

  .stack {
    margin: 0;
  }

  .stack > div {
    display: grid;
    grid-template-columns: 11rem minmax(0, 1fr);
    gap: 0.25rem 1.5rem;
    padding-block: 0.35rem;
  }

  .stack dt {
    font-weight: 600;
  }

  .stack dd {
    margin: 0;
    color: var(--muted);
  }

  @media (max-width: 640px) {
    .cv-section,
    .stack > div {
      grid-template-columns: 1fr;
    }
  }

  @media print {
    .cv {
      max-width: none;
      padding: 0;
    }

    .cv-head {
      padding-bottom: 0.6rem;
    }

    .cv-head .label {
      display: none;
    }

    .contact {
      font-size: 9.5pt;
    }

    .cv-head h1 {
      font-size: 20pt;
      color: #000;
    }

    .role,
    .contact,
    .contact a,
    .stack dd,
    .muted {
      color: #333;
    }

    .cv-section {
      grid-template-columns: 8.5rem minmax(0, 1fr);
      gap: 0.25rem 1.25rem;
      padding-block: 0.65rem;
      border-top: 1px solid #ccc;
      break-inside: avoid;
    }

    /* Una sección con varias entradas (Experiencia, Proyectos) puede seguir en la página siguiente, pero nunca
       parte una entrada */
    .cv-section:has(.entry + .entry) {
      break-inside: auto;
    }

    .entry {
      break-inside: avoid;
    }

    .cv-section > h2 {
      color: #000;
      font-weight: 600;
    }

    .entry + .entry {
      margin-top: 0.6rem;
    }

    .entry h3 {
      font-size: 10.5pt;
    }

    .entry li,
    .entry .meta {
      font-size: 9.5pt;
    }

    .entry li + li {
      margin-top: 0.1em;
    }

    .stack > div {
      grid-template-columns: 9.5rem minmax(0, 1fr);
      padding-block: 0.1rem;
    }
  }
</style>
