---
import Project from '../layouts/Project.astro';
import { getProject } from '../data/projects';
import { epistemePrs, figuresDate, getStep } from '../data/trail';
import EpistemeDiagram from '../components/diagrams/EpistemeDiagram.astro';
import Capabilities from '../components/Capabilities.astro';
import { getImage, Image } from 'astro:assets';
import grafoVault from '../assets/images/episteme/grafo-vault.png';
import grafoPoster from '../assets/images/episteme/grafo-poster.png';

// Póster del video: su último cuadro (el vault completo), en WebP
const poster = await getImage({ src: grafoPoster, format: 'webp', width: 960 });

const capabilities = [
  {
    title: 'Memoria por proyecto',
    text: 'Guarda decisiones, lecciones, errores y preferencias como notas ordenadas por proyecto.',
  },
  {
    title: 'Búsqueda en español',
    text: 'Busca por texto completo en todo el vault, sin distinguir mayúsculas ni tildes.',
  },
  {
    title: 'Normas antes de editar',
    text: 'Antes de editar un archivo, muestra las normas que le aplican.',
  },
  {
    title: 'Continuidad entre sesiones',
    text: 'Guarda el estado del trabajo antes de que la conversación se compacte y lo recupera después.',
  },
  {
    title: 'Control de calidad del vault',
    text: 'Detecta duplicados, memorias vencidas y enlaces rotos; rechaza guardar contraseñas y tokens.',
  },
];

const stack = [
  ['Servidor', 'Python 3.14+, MCP SDK'],
  ['Búsqueda', 'SQLite FTS5'],
  ['Almacenamiento', 'Markdown compatible con Obsidian'],
  ['Tooling', 'uv, ruff, pytest'],
];
const p = getProject('episteme');
const step = getStep('episteme');
---

<Project
  title={p.title}
  description={p.description}
  tagline={p.tagline}
  stack={p.stack}
  status={p.status}
  repoUrl={p.repoUrl}
>
  <h2>El problema</h2>
  <p>
    Un agente de código empieza cada sesión sin recordar la anterior. Las decisiones, las lecciones y el
    contexto del proyecto se pierden o hay que volver a explicarlos.
  </p>

  <h2>La solución</h2>
  <p>
    episteme le da al agente una memoria que dura: una carpeta de notas Markdown, el vault, donde quedan las
    decisiones, las lecciones y la documentación de cada proyecto. El agente la consulta y la completa
    mientras trabaja. Las notas son archivos de texto del usuario: se abren con Obsidian o con cualquier
    editor y no dependen de ningún servicio externo.
  </p>

  <h2>Cómo funciona</h2>
  <EpistemeDiagram />
  <ol>
    <li>
      El agente usa las herramientas de episteme cuando las necesita, y los hooks las invocan automáticamente en
      momentos definidos de la sesión.
    </li>
    <li>
      episteme se ejecuta en la máquina del usuario y es la única puerta al vault: valida lo que se guarda y
      mantiene un índice para buscar rápido.
    </li>
    <li>El vault es una carpeta de notas Markdown que el usuario puede leer y editar.</li>
  </ol>

  <h2>El vault en uso</h2>
  <p>
    Las notas no quedan sueltas: cada memoria se enlaza con las decisiones, los proyectos y la documentación con
    que se relaciona, y episteme sigue esos enlaces al buscar y al leer.
  </p>
  <figure class="graph glass">
    <video
      src="/assets/video/episteme-grafo.mp4"
      poster={poster.src}
      width="960"
      height="796"
      muted
      loop
      playsinline
      tabindex="0"
      preload="none"
      aria-label="Vista de grafo del vault que crece desde unos pocos puntos hasta varios núcleos de colores unidos por líneas finas."
    ></video>
    <figcaption>
      La historia del vault que uso a diario, acelerada en la vista de grafo de Obsidian: las notas aparecen en el
      orden en que se crearon. Cada punto es una nota y cada línea, un enlace entre dos notas; los colores separan
      grupos de notas y los puntos más grandes son los más enlazados.
    </figcaption>
  </figure>
  <figure class="graph glass">
    <Image
      src={grafoVault}
      alt="Vista de grafo del vault: puntos agrupados en varios núcleos de colores, unidos por líneas finas."
      widths={[640, 960, 1345]}
      sizes="(min-width: 48rem) 46rem, 100vw"
      loading="lazy"
    />
    <figcaption>El mismo grafo en una vista fija, sin la animación: los grupos de notas quedan a la vista.</figcaption>
  </figure>

  <h2>Capacidades</h2>
  <Capabilities items={capabilities} />

  <h2>Stack</h2>
  <div class="table-wrap">
    <table>
      <thead>
        <tr><th scope="col">Componente</th><th scope="col">Tecnología</th></tr>
      </thead>
      <tbody>
        {stack.map(([k, v]) => <tr><td>{k}</td><td>{v}</td></tr>)}
      </tbody>
    </table>
  </div>

  <h2>Estado del proyecto</h2>
  <p>
    <strong>En uso diario — v0.21.</strong> Entre octubre y noviembre de 2026 sumó {step.commits} commits y
    {step.prs} pull requests fusionados: {epistemePrs.before} antes de abrir el código y {epistemePrs.public} en el
    repositorio público (cifras de GitHub al {figuresDate}). Es también la memoria de este sitio: las decisiones de su
    diseño y de su contenido están guardadas en el vault.
  </p>
</Project>

<style>
  .graph {
    margin: 2rem 0;
    padding: 0.75rem;
  }
  .graph video,
  .graph img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: var(--radius);
    background: var(--bg);
  }
  .graph video {
    cursor: pointer;
  }
  .graph figcaption {
    margin-top: 0.75rem;
    padding-inline: 0.25rem;
    color: var(--muted);
    font-size: 0.875rem;
  }
</style>

<script>
  // Sin reproductor visible: se reproduce solo mientras está a la vista y sin
  // movimiento reducido (con movimiento reducido queda el póster, el vault
  // completo). Un clic, Enter o Espacio lo pausa y lo reanuda.
  const video = document.querySelector<HTMLVideoElement>('.graph video');
  if (
    video &&
    'IntersectionObserver' in window &&
    !window.matchMedia('(prefers-reduced-motion: reduce)').matches
  ) {
    let visible = false;
    let pausedByUser = false;
    video.addEventListener('pause', () => {
      if (visible) pausedByUser = true;
    });
    video.addEventListener('play', () => {
      pausedByUser = false;
    });
    const toggle = () => {
      if (video.paused) video.play().catch(() => {});
      else video.pause();
    };
    video.addEventListener('click', toggle);
    video.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        toggle();
      }
    });
    new IntersectionObserver(
      ([entry]) => {
        visible = entry.isIntersecting;
        if (visible && !pausedByUser) video.play().catch(() => {});
        else if (!visible) video.pause();
      },
      { threshold: 0.4 },
    ).observe(video);
  }
</script>
