---
import Project from '../layouts/Project.astro';
import { getProject } from '../data/projects';
import { epistemePrs, figuresDate, getStep } from '../data/trail';
import EpistemeDiagram from '../components/diagrams/EpistemeDiagram.astro';
import Capabilities from '../components/Capabilities.astro';
import EmbeddingsChart from '../components/EmbeddingsChart.astro';
import { getImage, Image } from 'astro:assets';
import grafoVault from '../assets/images/episteme/grafo-vault.png';
import grafoPoster from '../assets/images/episteme/grafo-poster.png';

// Póster del video: su último cuadro (el vault completo), en WebP
const poster = await getImage({ src: grafoPoster, format: 'webp', width: 960 });

const capabilities = [
  {
    title: 'Memoria compartida entre agentes',
    text: 'Claude Code y Gemini consultan y amplían la misma memoria del proyecto: lo que decide uno, el otro lo sabe en la sesión siguiente.',
  },
  {
    title: 'Normas antes de editar',
    text: 'Antes de editar un archivo, el agente ve las normas que le aplican y, después, lo que ya se sabe de él.',
  },
  {
    title: 'Memoria curada',
    text: 'Cada memoria tiene tipo, prioridad y vencimiento; la mantención propone unir duplicados, resolver contradicciones y archivar lo vencido, y se rechaza guardar contraseñas y tokens.',
  },
  {
    title: 'Continuidad del trabajo',
    text: 'El estado del trabajo sobrevive a /compact y a /clear: se guarda al compactar y se recupera al seguir.',
  },
  {
    title: 'Local y legible',
    text: 'Notas Markdown en tu equipo que se abren con Obsidian; el índice SQLite es una caché que se reconstruye sola. episteme no usa servicios en la nube.',
  },
  {
    title: 'Código abierto',
    text: 'Licencia MIT: el código y la documentación están en GitHub.',
  },
];

const embeddings = [
  { label: 'Sin resultados nuevos', value: 48 },
  { label: 'Solo resultados débiles (similitud < 0,65)', value: 96 },
  { label: 'Un acierto nuevo claro (≥ 0,65)', value: 3, strong: true },
];

const stack = [
  ['Servidor', 'Python 3.14+, MCP SDK'],
  ['Búsqueda', 'SQLite FTS5'],
  ['Almacenamiento', 'Markdown compatible con Obsidian'],
  ['Tooling', 'uv, ruff, pytest'],
];
const p = getProject('episteme');
const step = getStep('episteme');
---

<Project
  title={p.title}
  description={p.description}
  tagline={p.tagline}
  stack={p.stack}
  status={p.status}
  repoUrl={p.repoUrl}
>
  <h2>El problema</h2>
  <p>
    Un agente de código empieza cada sesión sin recordar la anterior, y cada agente guarda lo suyo por separado: lo
    que se decide con uno, el otro no lo sabe. Las decisiones, las lecciones y el contexto del proyecto se pierden o
    hay que volver a explicarlos.
  </p>

  <h2>La solución</h2>
  <p>
    episteme da a tus agentes una sola memoria de proyecto, curada: una carpeta de notas Markdown, el vault, con las
    decisiones, las lecciones, las normas y la documentación de cada proyecto. Claude Code la usa completa, con hooks
    que la consultan en momentos fijos de la sesión; Gemini, con agy, usa las mismas herramientas, sin automatismos.
    Lo que decide Claude lo sabe Gemini en la sesión siguiente. Las notas son archivos del usuario: se abren con
    Obsidian o con cualquier editor, y episteme no usa servicios en la nube.
  </p>

  <h2>Cómo funciona</h2>
  <EpistemeDiagram />
  <ol>
    <li>
      El agente usa las herramientas de episteme cuando las necesita, y los hooks las invocan automáticamente en
      momentos definidos de la sesión.
    </li>
    <li>
      episteme se ejecuta en la máquina del usuario y es la única puerta al vault: valida lo que se guarda y
      mantiene un índice para buscar rápido.
    </li>
    <li>El vault es una carpeta de notas Markdown que el usuario puede leer y editar.</li>
  </ol>

  <h2>El vault en uso</h2>
  <p>
    Las notas no quedan sueltas: cada memoria se enlaza con las decisiones, los proyectos y la documentación con
    que se relaciona, y episteme sigue esos enlaces al buscar y al leer.
  </p>
  <div class="graph glass" data-graph-viewer>
    <div class="graph-bar" hidden>
      <div class="graph-tabs" role="tablist" aria-label="Vista del grafo del vault">
        <button
          type="button"
          class="graph-tab mono"
          role="tab"
          id="tab-evolucion"
          aria-controls="panel-evolucion"
          aria-selected="true"
          data-tab="evolucion"
        >
          Evolución
        </button>
        <button
          type="button"
          class="graph-tab mono"
          role="tab"
          id="tab-fija"
          aria-controls="panel-fija"
          aria-selected="false"
          tabindex="-1"
          data-tab="fija"
        >
          Vista fija
        </button>
      </div>
      <button type="button" class="graph-toggle mono" data-video-toggle>
        <span class="toggle-dot" aria-hidden="true"></span>
        <span data-toggle-label>En pausa · Reproducir</span>
      </button>
    </div>

    <div class="graph-panel" id="panel-evolucion" role="tabpanel" aria-labelledby="tab-evolucion" data-panel="evolucion">
      <figure class="graph-figure">
        <video
          src="/assets/video/episteme-grafo.mp4"
          poster={poster.src}
          width="960"
          height="796"
          muted
          loop
          playsinline
          tabindex="0"
          preload="none"
          aria-label="Vista de grafo del vault que crece desde unos pocos puntos hasta varios núcleos de colores unidos por líneas finas."
        ></video>
        <figcaption>
          La historia del vault que uso a diario, acelerada en la vista de grafo de Obsidian: las notas aparecen en el
          orden en que se crearon. Cada punto es una nota y cada línea, un enlace entre dos notas; los colores separan
          grupos de notas y los puntos más grandes son los más enlazados.
        </figcaption>
      </figure>
    </div>

    <div class="graph-panel" id="panel-fija" role="tabpanel" aria-labelledby="tab-fija" data-panel="fija">
      <figure class="graph-figure">
        <Image
          src={grafoVault}
          alt="Vista de grafo del vault: puntos agrupados en varios núcleos de colores, unidos por líneas finas."
          widths={[640, 960, 1345]}
          sizes="(min-width: 48rem) 46rem, 100vw"
          loading="lazy"
        />
        <figcaption>
          El mismo grafo completo en una vista fija de alta resolución: los núcleos por proyecto y la densidad de enlaces
          quedan detenidos para inspeccionarlos con calma.
        </figcaption>
      </figure>
    </div>
  </div>

  <h2>Capacidades</h2>
  <Capabilities items={capabilities} />

  <h2>Búsqueda por palabras, no por embeddings</h2>
  <p>
    episteme busca por palabras clave (SQLite FTS5, sin distinguir mayúsculas ni tildes), no por embeddings. Es una
    decisión medida: el 15 de noviembre de 2026 comparé la búsqueda con los vecinos semánticos de bge-m3 sobre 147
    consultas reales de mi vault, con 523 memorias.
  </p>
  <EmbeddingsChart date="15 de noviembre de 2026" total={147} rows={embeddings} />
  <p>
    Solo 3 consultas ganaron un resultado nuevo que de verdad respondía; el resto no ganó nada o sumó resultados sin
    relación. A cambio, cada consulta tardaba 1,47 s en CPU, vectorizar el vault tomaba 10 minutos y episteme pasaba a
    depender de Ollama. El método está en
    <a href="https://github.com/Bajmein/episteme/blob/main/scripts/measure_semantic.py">measure_semantic.py</a> y las
    cifras, en la
    <a href="https://github.com/Bajmein/episteme/blob/main/docs/desarrollo.md#resultado-15-11-2026"
      >documentación del repositorio</a
    >.
  </p>

  <h2>Instalación</h2>
  <p>
    Requiere uv y git, y funciona en Linux, macOS y Windows. El plugin se instala una vez por máquina, desde el
    marketplace del repositorio:
  </p>
  <pre><code>claude plugin marketplace add Bajmein/episteme
claude plugin install episteme@episteme</code></pre>
  <p>
    Después, en cada proyecto, <code>/episteme:setup</code> registra el servidor, configura los hooks y los permisos
    y añade la regla al CLAUDE.md; antes de escribir, muestra los cambios para que los apruebes. También se puede
    registrar a mano con <code>claude mcp add</code>, fijado a una versión. Con Gemini, <code>/episteme:agy</code>
    activa agy en el proyecto.
  </p>

  <h2>Stack</h2>
  <div class="table-wrap">
    <table>
      <thead>
        <tr><th scope="col">Componente</th><th scope="col">Tecnología</th></tr>
      </thead>
      <tbody>
        {stack.map(([k, v]) => <tr><td>{k}</td><td>{v}</td></tr>)}
      </tbody>
    </table>
  </div>

  <h2>Por qué lo construí</h2>
  <p>
    Lo empecé porque la herramienta de memoria que usaba fallaba a menudo y limitaba funciones a su versión de pago.
    Diseñé episteme con dos reglas: las notas nunca dependen de que el índice funcione, y la documentación es parte
    del producto.
  </p>

  <h2>Estado del proyecto</h2>
  <p>
    <strong>En uso diario — v0.21.</strong> Entre octubre y noviembre de 2026 sumó {step.commits} commits y
    {step.prs} pull requests fusionados: {epistemePrs.before} antes de abrir el código y {epistemePrs.public} en el
    repositorio público (cifras de GitHub al {figuresDate}). Es también la memoria de este sitio: las decisiones de su
    diseño y de su contenido están guardadas en el vault.
  </p>
</Project>

<style>
  .graph {
    margin: 2rem 0;
    padding: 0.85rem;
  }

  .graph-bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem 1rem;
    margin-bottom: 0.75rem;
    padding-inline: 0.15rem;
  }

  .graph-tabs {
    display: inline-flex;
    padding: 0.2rem;
    border-radius: var(--radius);
    background: color-mix(in srgb, var(--bg) 70%, transparent);
    border: 1px solid var(--border);
  }

  .graph-tab {
    appearance: none;
    border: 0;
    background: transparent;
    color: var(--muted);
    font-size: 0.8125rem;
    font-weight: 500;
    padding: 0.35rem 0.75rem;
    border-radius: 4px;
    cursor: pointer;
    transition: color 0.15s ease, background-color 0.15s ease;
  }

  .graph-tab:hover {
    color: var(--text);
  }

  .graph-tab[aria-selected='true'] {
    background: color-mix(in srgb, var(--accent) 18%, var(--surface));
    color: var(--text);
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--accent) 45%, transparent);
  }

  .graph-toggle {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    appearance: none;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: color-mix(in srgb, var(--bg) 55%, transparent);
    color: var(--muted);
    font-size: 0.75rem;
    padding: 0.3rem 0.7rem;
    cursor: pointer;
    transition: border-color 0.15s ease, color 0.15s ease;
  }

  .graph-toggle:hover {
    border-color: var(--accent);
    color: var(--text);
  }

  .graph-bar[hidden],
  .graph-toggle[hidden],
  .graph-panel[hidden] {
    display: none;
  }

  .toggle-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--muted);
    transition: background-color 0.15s ease;
  }

  .graph-toggle.is-playing .toggle-dot {
    background: var(--tone-vigilia);
  }

  .graph video,
  .graph img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: var(--radius);
    background: var(--bg);
  }

  .graph video {
    cursor: pointer;
  }

  .graph-figure {
    margin: 0;
  }

  .graph-panel + .graph-panel {
    margin-top: 1.5rem;
  }

  .graph figcaption {
    margin-top: 0.75rem;
    padding-inline: 0.25rem;
    color: var(--muted);
    font-size: 0.875rem;
  }
</style>

<script>
  const viewer = document.querySelector<HTMLElement>('[data-graph-viewer]');
  if (viewer) {
    const video = viewer.querySelector<HTMLVideoElement>('video');
    const toggleBtn = viewer.querySelector<HTMLButtonElement>('[data-video-toggle]');
    const toggleLabel = viewer.querySelector<HTMLElement>('[data-toggle-label]');
    const tabs = [...viewer.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
    const panels = [...viewer.querySelectorAll<HTMLElement>('[role="tabpanel"]')];
    const bar = viewer.querySelector<HTMLElement>('.graph-bar');
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (bar) bar.hidden = false;

    let activeTab = 'evolucion';
    let visible = false;
    let pausedByUser = false;

    const syncToggle = () => {
      if (!video || !toggleBtn || !toggleLabel) return;
      const playing = !video.paused && !video.ended;
      toggleBtn.classList.toggle('is-playing', playing);
      toggleLabel.textContent = playing ? 'En reproducción · Pausar' : 'En pausa · Reproducir';
    };

    const setTab = (id: string, focus = false) => {
      activeTab = id;
      for (const t of tabs) {
        const selected = t.dataset.tab === id;
        t.setAttribute('aria-selected', String(selected));
        t.tabIndex = selected ? 0 : -1;
        if (selected && focus) t.focus();
      }
      for (const p of panels) {
        p.hidden = p.dataset.panel !== id;
      }
      if (toggleBtn) toggleBtn.hidden = id !== 'evolucion';
      if (video) {
        if (id !== 'evolucion') video.pause();
        else if (visible && !pausedByUser && !reducedMotion) video.play().catch(() => {});
      }
      syncToggle();
    };

    for (const [idx, tab] of tabs.entries()) {
      tab.addEventListener('click', () => setTab(tab.dataset.tab ?? 'evolucion'));
      tab.addEventListener('keydown', (e) => {
        if (e.key !== 'ArrowRight' && e.key !== 'ArrowLeft') return;
        e.preventDefault();
        const next = tabs[(idx + (e.key === 'ArrowRight' ? 1 : tabs.length - 1)) % tabs.length];
        if (next?.dataset.tab) setTab(next.dataset.tab, true);
      });
    }

    if (video) {
      const toggleVideo = () => {
        if (video.paused) {
          pausedByUser = false;
          video.play().catch(() => {});
        } else {
          pausedByUser = true;
          video.pause();
        }
        syncToggle();
      };

      video.addEventListener('play', syncToggle);
      video.addEventListener('pause', syncToggle);
      video.addEventListener('click', toggleVideo);
      video.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          toggleVideo();
        }
      });
      toggleBtn?.addEventListener('click', toggleVideo);

      if ('IntersectionObserver' in window && !reducedMotion) {
        new IntersectionObserver(
          ([entry]) => {
            visible = entry.isIntersecting;
            if (visible && activeTab === 'evolucion' && !pausedByUser) {
              video.play().catch(() => {});
            } else if (!visible) {
              video.pause();
            }
            syncToggle();
          },
          { threshold: 0.4 },
        ).observe(video);
      }
      syncToggle();
    }

    setTab('evolucion');
  }
</script>
